# -*- coding: utf-8 -*-import arcpyimport osfrom datetime import dateclass Toolbox:    def __init__(self):        self.label = "Source Feature Modifier"        self.alias = "source_modifier"        self.tools = [Tool]class Tool:    def __init__(self):        self.label = "Create sf_point from iNaturalist Observations"        self.description = (            "Creates sf_point, tbl_sf_visits and tbl_sf_references from source feature."        )    # =========================================================    # PARAMETER DEFINITIONS    # =========================================================    def getParameterInfo(self):        # -----------------------------------------------------        # INPUT FEATURE CLASS        # -----------------------------------------------------        in_fc = arcpy.Parameter(            displayName="Input Point Feature Class",            name="in_fc",            datatype="DEFeatureClass",            parameterType="Required",            direction="Input"        )        # -----------------------------------------------------        # MAP_BY        # User enters this manually.        # -----------------------------------------------------        map_by_input = arcpy.Parameter(            displayName="MAP_BY (Required Custom Text, max 20 chars)",            name="map_by_input",            datatype="GPString",            parameterType="Required",            direction="Input"        )        # -----------------------------------------------------        # LICENSE CODE SOURCE FIELD        # Optional field selected from input feature class.        # -----------------------------------------------------        license_code_field = arcpy.Parameter(            displayName="License Code Field (optional)",            name="license_code_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        license_code_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # MAP_COM SOURCE FIELD        # -----------------------------------------------------        map_com_field = arcpy.Parameter(            displayName="MAP_COM Source Field (optional)",            name="map_com_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        map_com_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # DIG_COM SOURCE FIELD        # -----------------------------------------------------        dig_com_field = arcpy.Parameter(            displayName="DIG_COM Source Field (optional)",            name="dig_com_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        dig_com_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # DESCRIPTOR SOURCE FIELD        # -----------------------------------------------------        descriptor_field = arcpy.Parameter(            displayName="DESCRIPTOR Source Field (optional)",            name="descriptor_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        descriptor_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # UNIQUEID SOURCE FIELD        # -----------------------------------------------------        uniqueid_field = arcpy.Parameter(            displayName="UNIQUEID Source Field (REQUIRED)",            name="uniqueid_field",            datatype="Field",            parameterType="Required",            direction="Input"        )        uniqueid_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # DISTANCE / POSITIONAL UNCERTAINTY SOURCE FIELD        # -----------------------------------------------------        distance_field = arcpy.Parameter(            displayName=(                "Positional Uncertainty(REQUIRED)"            ),            name="distance_field",            datatype="Field",            parameterType="Required",            direction="Input"        )        distance_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # SNAME SOURCE FIELD        # -----------------------------------------------------        sname_field = arcpy.Parameter(            displayName="SNAME(REQUIRED)",            name="sname_field",            datatype="Field",            parameterType="Required",            direction="Input"        )        sname_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # EST_ID SOURCE FIELD        # -----------------------------------------------------        est_id_field = arcpy.Parameter(            displayName="EST_ID Source Field (REQUIRED)",            name="est_id_field",            datatype="Field",            parameterType="Required",            direction="Input"        )        est_id_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # V_BY SOURCE FIELD        # -----------------------------------------------------        v_by_field = arcpy.Parameter(            displayName="VISIT BY(optional)",            name="v_by_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        v_by_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # V_DATE SOURCE FIELD        # -----------------------------------------------------        v_date_field = arcpy.Parameter(            displayName="VISIT DATE Source Field (optional)",            name="v_date_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        v_date_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # V_NOTE SOURCE FIELD        # -----------------------------------------------------        v_note_field = arcpy.Parameter(            displayName="VISIT NOTE Source Field (optional)",            name="v_note_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        v_note_field.parameterDependencies = [            in_fc.name        ]        # -----------------------------------------------------        # OUTPUT FEATURE CLASS        # -----------------------------------------------------        output_fc = arcpy.Parameter(            displayName="Output Feature Class",            name="output_fc",            datatype="DEFeatureClass",            parameterType="Derived",            direction="Output"        )        # -----------------------------------------------------        # RETURN PARAMETERS        # -----------------------------------------------------        return [            in_fc,            map_by_input,            license_code_field,            map_com_field,            dig_com_field,            descriptor_field,            uniqueid_field,            distance_field,            sname_field,            est_id_field,            v_by_field,            v_date_field,            v_note_field,            output_fc        ]    # =========================================================    # UPDATE PARAMETERS    # =========================================================    def updateParameters(self, parameters):        # -----------------------------------------------------        # Make sure all Field parameters remain dependent on        # the selected input feature class.        # -----------------------------------------------------        if parameters[0].value:            for index in range(2, 13):                parameters[index].parameterDependencies = [                    parameters[0].name                ]        return    # =========================================================    # EXECUTE    # =========================================================    def execute(self, parameters, messages):        # -----------------------------------------------------        # READ PARAMETERS        # -----------------------------------------------------        in_fc = parameters[0].valueAsText        map_by_input = parameters[1].valueAsText        license_code_field = parameters[2].valueAsText        map_com_field = parameters[3].valueAsText        dig_com_field = parameters[4].valueAsText        descriptor_field = parameters[5].valueAsText        uniqueid_field = parameters[6].valueAsText        distance_field = parameters[7].valueAsText        sname_field = parameters[8].valueAsText        est_id_field = parameters[9].valueAsText        v_by_field = parameters[10].valueAsText        v_date_field = parameters[11].valueAsText        v_note_field = parameters[12].valueAsText        output_fc = parameters[13]        # -----------------------------------------------------        # VALIDATE MAP_BY        # -----------------------------------------------------        if map_by_input is None:            map_by_input = ""        else:            map_by_input = map_by_input.strip()        if len(map_by_input) > 20:            arcpy.AddWarning(                "MAP_BY truncated to 20 characters."            )            map_by_input = map_by_input[:20]        # -----------------------------------------------------        # DESCRIBE INPUT        # -----------------------------------------------------        desc = arcpy.Describe(in_fc)        in_workspace = desc.path        in_sr = desc.spatialReference        # -----------------------------------------------------        # OUTPUT PATHS        # -----------------------------------------------------        out_fc_path = os.path.join(            in_workspace,            "sf_point"        )        visits = os.path.join(            in_workspace,            "tbl_sf_visits"        )        refs = os.path.join(            in_workspace,            "tbl_sf_references"        )        # -----------------------------------------------------        # DELETE EXISTING OUTPUTS        # -----------------------------------------------------        output_names = [            out_fc_path,            visits,            refs        ]        for output_name in output_names:            if arcpy.Exists(output_name):                arcpy.Delete_management(                    output_name                )        # -----------------------------------------------------        # CREATE sf_point        # -----------------------------------------------------        arcpy.CreateFeatureclass_management(            in_workspace,            "sf_point",            "POINT",            has_z="DISABLED",            has_m="DISABLED",            spatial_reference=in_sr        )        # =====================================================        # FIELD CREATION HELPERS        # =====================================================        def add_text(field_name, field_length):            arcpy.AddField_management(                out_fc_path,                field_name,                "TEXT",                field_length=field_length            )        def add_double(field_name):            arcpy.AddField_management(                out_fc_path,                field_name,                "DOUBLE"            )        # =====================================================        # CREATE sf_point FIELDS        # =====================================================        add_double("UNIQUEID")        add_text(            "CONC_FEAT_",            10        )        add_text(            "LOC_UNCERT",            30        )        add_double(            "DISTANCE"        )        add_text(            "DIST_UNIT",            20        )        add_text(            "MAP_BY",            20        )        add_text(            "MAP_DATE",            10        )        add_text(            "MAP_COM",            1000        )        add_text(            "SNAME",            100        )        add_double(            "EST_ID"        )        add_text(            "QC_BY",            20        )        add_text(            "QC_STATUS",            60        )        add_text(            "QC_COM",            1000        )        add_text(            "DESCRIPTOR",            250        )        add_text(            "LOCATOR",            250        )        add_text(            "LOC_USE",            40        )        add_text(            "UH_EX",            1        )        add_text(            "DIG_BASE",            60        )        add_text(            "DIG_COM",            1000        )        add_text(            "REP_ACC",            30        )        add_text(            "REP_COM",            4000        )        add_double(            "OBS_AR_LEN"        )        add_text(            "OBS_AL_UNI",            20        )        add_double(            "EO_ID"        )        add_text(            "EO_NEW",            25        )        add_text(            "EODISTCOM",            1000        )        add_text(            "EO_NEW_COM",            4000        )        add_text(            "EO_MAP_BY",            20        )        add_text(            "EO_MAP_DT",            30        )        add_text(            "EO_QC_BY",            20        )        add_text(            "EO_QC_ST",            60        )        add_text(            "EO_QC_COM",            1000        )        # =====================================================        # RESOLVE INPUT FIELD NAMES        # =====================================================        lookup = {            f.name.lower(): f.name            for f in arcpy.ListFields(in_fc)        }        def resolve_field(field_name):            if not field_name:                return None            return lookup.get(                field_name.lower(),                field_name            )        license_code_f = resolve_field(            license_code_field        )        mapcom_f = resolve_field(            map_com_field        )        digcom_f = resolve_field(            dig_com_field        )        desc_f = resolve_field(            descriptor_field        )        uniqueid_f = resolve_field(            uniqueid_field        )        distance_f = resolve_field(            distance_field        )        sname_f = resolve_field(            sname_field        )        estid_f = resolve_field(            est_id_field        )        # =====================================================        # BUILD INPUT CURSOR FIELDS        # =====================================================        in_fields = [            "OID@",            "SHAPE@XY",            uniqueid_f,            distance_f,            sname_f,            estid_f        ]        if license_code_f:            in_fields.append(                license_code_f            )        if mapcom_f:            in_fields.append(                mapcom_f            )        if digcom_f:            in_fields.append(                digcom_f            )        if desc_f:            in_fields.append(                desc_f            )        # =====================================================        # OUTPUT CURSOR FIELDS        # =====================================================        out_fields = [            "SHAPE@",            "UNIQUEID",            "CONC_FEAT_",            "LOC_UNCERT",            "DISTANCE",            "DIST_UNIT",            "MAP_BY",            "MAP_DATE",            "MAP_COM",            "SNAME",            "EST_ID",            "QC_BY",            "QC_STATUS",            "QC_COM",            "DESCRIPTOR",            "LOCATOR",            "LOC_USE",            "UH_EX",            "DIG_BASE",            "DIG_COM",            "REP_ACC",            "REP_COM",            "OBS_AR_LEN",            "OBS_AL_UNI",            "EO_ID",            "EO_NEW",            "EODISTCOM",            "EO_NEW_COM",            "EO_MAP_BY",            "EO_MAP_DT",            "EO_QC_BY",            "EO_QC_ST",            "EO_QC_COM"        ]        run_date = date.today().strftime(            "%Y-%m-%d"        )        # =====================================================        # LICENSE CODE → REF_ID        # =====================================================        license_ref_map = {            "CC0": 319236,            "CC-BY": 318207,            "CC-BY-NC": 318208,            "CC-BY-NC-SA": 319235,            "All Rights Reserved": 318947        }        # =====================================================        # REP_ACC / REP_COM CALCULATION        #        # Distance is positional uncertainty in meters.        #        # Distance < 0.5 m:        #     High        #     PF < 1 ha        #        # Distance 0.5–25 m:        #     Medium        #     PF < 50 ha        #        # Distance > 25 m:        #     Low        # =====================================================        def calculate_representation(            distance_value        ):            if distance_value is None:                return None, None            try:                distance = float(                    distance_value                )            except (                TypeError,                ValueError            ):                return None, None            if distance < 0:                return None, None            # ---------------------------------------------            # HIGH            # ---------------------------------------------            if distance < 0.5:                rep_acc = "High"                rep_com = (                    "Point CF, Estimated LU "                    "{}m, PF < 1 ha."                    .format(                        distance_value                    )                )            # ---------------------------------------------            # MEDIUM            # ---------------------------------------------            elif distance <= 25:                rep_acc = "Medium"                rep_com = (                    "Point CF, Estimated LU "                    "{}m, PF < 50 ha."                    .format(                        distance_value                    )                )            # ---------------------------------------------            # LOW            # ---------------------------------------------            else:                rep_acc = "Low"                rep_com = (                    "Point CF, Estimated LU "                    "{}m."                    .format(                        distance_value                    )                )            return rep_acc, rep_com        # =====================================================        # DIG_BASE CALCULATION        # =====================================================        def calculate_dig_base(            distance_value        ):            if distance_value is None:                return None            try:                distance = float(                    distance_value                )            except (                TypeError,                ValueError            ):                return None            if distance < 0:                return None            # <= 4.5 m            if distance <= 4.5:                return "GPS: <=4.5m"            # >4.5 m through 5 m            elif distance <= 5:                return "GPS: >4.5m"            # >5 m through 10 m            elif distance <= 10:                return "GPS:5-10m"            # >10 m            else:                return "GPS:>10m"        # =====================================================        # CREATE sf_point RECORDS        # =====================================================        with arcpy.da.SearchCursor(            in_fc,            in_fields        ) as search_cursor, arcpy.da.InsertCursor(            out_fc_path,            out_fields        ) as insert_cursor:            for row in search_cursor:                idx = 0                # ---------------------------------------------                # OID                # ---------------------------------------------                oid = row[idx]                idx += 1                # ---------------------------------------------                # GEOMETRY                # ---------------------------------------------                xy = row[idx]                idx += 1                # ---------------------------------------------                # UNIQUEID                # ---------------------------------------------                uniqueid_raw = row[idx]                idx += 1                try:                    uniqueid_val = float(                        uniqueid_raw                    )                except (                    TypeError,                    ValueError                ):                    uniqueid_val = None                # ---------------------------------------------                # DISTANCE                # ---------------------------------------------                distance_raw = row[idx]                idx += 1                try:                    if distance_raw in (                        None,                        ""                    ):                        distance_val = None                    else:                        distance_val = float(                            distance_raw                        )                except (                    TypeError,                    ValueError                ):                    distance_val = None                # ---------------------------------------------                # SNAME                # ---------------------------------------------                sname_val = row[idx]                idx += 1                # ---------------------------------------------                # EST_ID                # ---------------------------------------------                est_raw = row[idx]                idx += 1                try:                    if est_raw in (                        None,                        ""                    ):                        est_val = None                    else:                        est_val = float(                            est_raw                        )                except (                    TypeError,                    ValueError                ):                    est_val = None                # ---------------------------------------------                # LICENSE CODE                # ---------------------------------------------                license_code_val = None                ref_id_value = None                if license_code_f:                    license_code_val = row[idx]                    idx += 1                    if license_code_val not in (                        None,                        ""                    ):                        license_code_val = str(                            license_code_val                        ).strip()                        ref_id_value = (                            license_ref_map.get(                                license_code_val                            )                        )                # ---------------------------------------------                # MAP_COM                # ---------------------------------------------                mapcom_val = None                if mapcom_f:                    mapcom_val = row[idx]                    idx += 1                    if mapcom_val:                        mapcom_val = str(                            mapcom_val                        )[:1000]                # ---------------------------------------------                # DIG_COM                # ---------------------------------------------                digcom_val = (                    "Used coordinates provided in "                    "iNaturalist submission."                )                if digcom_f:                    digcom_val = row[idx]                    idx += 1                    if digcom_val:                        digcom_val = str(                            digcom_val                        )[:1000]                    else:                        digcom_val = (                            "Used coordinates provided in "                            "iNaturalist submission."                        )                # ---------------------------------------------                # DESCRIPTOR                # ---------------------------------------------                desc_val = None                if desc_f:                    desc_val = row[idx]                    idx += 1                    if desc_val:                        desc_val = str(                            desc_val                        )[:250]                # ---------------------------------------------                # REP_ACC / REP_COM                # ---------------------------------------------                repacc_val, repcom_val = (                    calculate_representation(                        distance_val                    )                )                # ---------------------------------------------                # DIG_BASE                # ---------------------------------------------                digbase_val = (                    calculate_dig_base(                        distance_val                    )                )                # ---------------------------------------------                # GEOMETRY                # ---------------------------------------------                geom = arcpy.PointGeometry(                    arcpy.Point(*xy),                    in_sr                )                # ---------------------------------------------                # INSERT                # ---------------------------------------------                insert_cursor.insertRow([                    geom,                    uniqueid_val,                    "Point",                    "Estimated",                    distance_val,                    "Meters",                    map_by_input,                    run_date,                    mapcom_val,                    (                        str(sname_val)[:100]                        if sname_val                        else None                    ),                    est_val,                    None,                    None,                    None,                    desc_val,                    None,                    None,                    "N",                    digbase_val,                    digcom_val,                    repacc_val,                    repcom_val,                    None,                    None,                    None,                    None,                    None,                    None,                    None,                    None,                    None,                    None,                    None                ])        # =====================================================        # CREATE VISITS TABLE        # =====================================================        arcpy.CreateTable_management(            in_workspace,            "tbl_sf_visits"        )        arcpy.AddField_management(            visits,            "V_BY",            "TEXT",            field_length=250        )        arcpy.AddField_management(            visits,            "V_DATE",            "TEXT",            field_length=50        )        arcpy.AddField_management(            visits,            "V_NOTE",            "TEXT",            field_length=2000        )        arcpy.AddField_management(            visits,            "SF_TYPE",            "TEXT",            field_length=10        )        arcpy.AddField_management(            visits,            "SF_UNIQUEID",            "LONG"        )        # -----------------------------------------------------        # Visit input fields        # -----------------------------------------------------        vis_input = [            "OID@",            uniqueid_f        ]        vis_map = []        if v_by_field:            vis_input.append(                resolve_field(                    v_by_field                )            )            vis_map.append(                "V_BY"            )        if v_date_field:            vis_input.append(                resolve_field(                    v_date_field                )            )            vis_map.append(                "V_DATE"            )        if v_note_field:            vis_input.append(                resolve_field(                    v_note_field                )            )            vis_map.append(                "V_NOTE"            )        # =====================================================        # POPULATE VISITS TABLE        # =====================================================        with arcpy.da.SearchCursor(            in_fc,            vis_input        ) as visit_search, arcpy.da.InsertCursor(            visits,            [                "V_BY",                "V_DATE",                "V_NOTE",                "SF_TYPE",                "SF_UNIQUEID"            ]        ) as visit_insert:            for row in visit_search:                uniqueid_raw = row[1]                vals = [                    None,                    None,                    None                ]                for j, name in enumerate(                    vis_map                ):                    val = row[j + 2]                    if val:                        if name == "V_BY":                            val = str(                                val                            )[:250]                        elif name == "V_DATE":                            val = str(                                val                            )[:10]                        elif name == "V_NOTE":                            val = str(                                val                            )[:2000]                    vals[j] = val                try:                    sf_uniqueid = int(                        uniqueid_raw                    )                except (                    TypeError,                    ValueError                ):                    sf_uniqueid = None                visit_insert.insertRow([                    vals[0],                    vals[1],                    vals[2],                    "point",                    sf_uniqueid                ])        # =====================================================        # CREATE REFERENCES TABLE        # =====================================================        arcpy.CreateTable_management(            in_workspace,            "tbl_sf_references"        )        arcpy.AddField_management(            refs,            "REF_ID",            "DOUBLE"        )        arcpy.AddField_management(            refs,            "REF_PRIM",            "TEXT",            field_length=1        )        arcpy.AddField_management(            refs,            "SF_TYPE",            "TEXT",            field_length=10        )        arcpy.AddField_management(            refs,            "SF_UNIQUEID",            "LONG"        )        # =====================================================        # REFERENCES INPUT FIELDS        # =====================================================        ref_input = [            "OID@",            uniqueid_f        ]        if license_code_f:            ref_input.append(                license_code_f            )        # =====================================================        # POPULATE REFERENCES TABLE        #        # License → REF_ID:        #        # CC0                 → 319236        # CC-BY               → 318207        # CC-BY-NC            → 318208        # CC-BY-NC-SA         → 319235        # All Rights Reserved → 318947        #        # Any other value     → NULL        # =====================================================        with arcpy.da.SearchCursor(            in_fc,            ref_input        ) as ref_search, arcpy.da.InsertCursor(            refs,            [                "REF_ID",                "REF_PRIM",                "SF_TYPE",                "SF_UNIQUEID"            ]        ) as ref_insert:            for row in ref_search:                # ---------------------------------------------                # UNIQUEID                # ---------------------------------------------                uniqueid_raw = row[1]                try:                    uniqueid_val = int(                        uniqueid_raw                    )                except (                    TypeError,                    ValueError                ):                    uniqueid_val = None                # ---------------------------------------------                # REF_ID                # ---------------------------------------------                ref_id_value = None                if license_code_f:                    license_value = row[2]                    if license_value not in (                        None,                        ""                    ):                        license_value = str(                            license_value                        ).strip()                        ref_id_value = (                            license_ref_map.get(                                license_value                            )                        )                # ---------------------------------------------                # INSERT REFERENCE                # ---------------------------------------------                ref_insert.insertRow([                    ref_id_value,                    "N",                    "point",                    uniqueid_val                ])        # =====================================================        # SET OUTPUT PARAMETER        # =====================================================        parameters[13].value = out_fc_path        # =====================================================        # MESSAGES        # =====================================================        arcpy.AddMessage(            "sf_point and related tables created successfully."        )        if license_code_f:            arcpy.AddMessage(                "License source field: {}".format(                    license_code_f                )            )        else:            arcpy.AddMessage(                "No license source field was selected. "                "REF_ID values will be NULL."            )        if digcom_f:            arcpy.AddMessage(                "DIG_COM source field: {}".format(                    digcom_f                )            )        else:            arcpy.AddMessage(                "No DIG_COM source field was selected. "                "DIG_COM will default to the iNaturalist "                "coordinate statement."            )        arcpy.AddMessage(            "REP_ACC and REP_COM calculated from DISTANCE."        )        arcpy.AddMessage(            "DIG_BASE calculated from DISTANCE."        )    # =========================================================    # POST EXECUTE    # =========================================================    def postExecute(self, parameters):        return