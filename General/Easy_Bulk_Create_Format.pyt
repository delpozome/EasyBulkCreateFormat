# -*- coding: utf-8 -*-import arcpyimport osfrom datetime import date, datetimeclass Toolbox:    def __init__(self):        self.label = "Source Feature Modifier"        self.alias = "source_modifier"        self.tools = [Tool]class Tool:    def __init__(self):        self.label = "Create source feature, visit and reference table"        self.description = (            "Creates sf_line, sf_point, or sf_poly from the geometry "            "of an input feature class. Curved polygon geometry is "            "converted to standard straight-segment polygon geometry "            "to prevent MULTISURFACE import errors."        )    # ======================================================================    # PARAMETERS    # ======================================================================    def getParameterInfo(self):        in_fc = arcpy.Parameter(            displayName="Input Feature Class (required)",            name="in_fc",            datatype="Feature Class",            parameterType="Required",            direction="Input"        )        uniqueid_field = arcpy.Parameter(            displayName="UNIQUEID Source Field (required)",            name="uniqueid_field",            datatype="Field",            parameterType="Required",            direction="Input"        )        uniqueid_field.parameterDependencies = ["in_fc"]        loc_uncert = arcpy.Parameter(            displayName=(                "LOC_UNCERT Source Field "                "(optional; defaults to Negligible)"            ),            name="loc_uncert",            datatype="Field",            parameterType="Optional",            direction="Input"        )        loc_uncert.parameterDependencies = ["in_fc"]        distance_field = arcpy.Parameter(            displayName=(                "DISTANCE Source Field "                "(optional; must be in meters)"            ),            name="distance_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        distance_field.parameterDependencies = ["in_fc"]        map_by_input = arcpy.Parameter(            displayName="MAP_BY (optional custom text, max 20 chars)",            name="map_by_input",            datatype="String",            parameterType="Optional",            direction="Input"        )        map_com_field = arcpy.Parameter(            displayName="MAP_COM Source Field (optional)",            name="map_com_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        map_com_field.parameterDependencies = ["in_fc"]        sname_field = arcpy.Parameter(            displayName="SNAME Source Field (optional)",            name="sname_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        sname_field.parameterDependencies = ["in_fc"]        est_id_field = arcpy.Parameter(            displayName="EST_ID Source Field (required)",            name="est_id_field",            datatype="Field",            parameterType="Required",            direction="Input"        )        est_id_field.parameterDependencies = ["in_fc"]        descriptor_field = arcpy.Parameter(            displayName="DESCRIPTOR Source Field (optional, 250 chars)",            name="descriptor_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        descriptor_field.parameterDependencies = ["in_fc"]        luc_use = arcpy.Parameter(            displayName=(                "LUC_USE Source Field "                "(optional; defaults to Undetermined)"            ),            name="luc_use",            datatype="Field",            parameterType="Optional",            direction="Input"        )        luc_use.parameterDependencies = ["in_fc"]        dig_base = arcpy.Parameter(            displayName="DIG_BASE (optional)",            name="dig_base",            datatype="String",            parameterType="Optional",            direction="Input"        )        dig_base.filter.type = "ValueList"        dig_base.filter.list = [            "GPS: <=4.5m",            "GPS: >4.5m",            "GPS:5-10m",            "GPS:>10m"        ]        dig_com_field = arcpy.Parameter(            displayName="DIG_COM Source Field (optional)",            name="dig_com_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        dig_com_field.parameterDependencies = ["in_fc"]        repacc_field = arcpy.Parameter(            displayName="REP_ACC Source Field (optional, 30 chars)",            name="repacc_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        repacc_field.parameterDependencies = ["in_fc"]        repcom_field = arcpy.Parameter(            displayName="REP_COM Source Field (optional, 4000 chars)",            name="repcom_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        repcom_field.parameterDependencies = ["in_fc"]        v_by_field = arcpy.Parameter(            displayName="V_BY Source Field (optional)",            name="v_by_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        v_by_field.parameterDependencies = ["in_fc"]        v_date_field = arcpy.Parameter(            displayName="V_DATE Source Field (optional)",            name="v_date_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        v_date_field.parameterDependencies = ["in_fc"]        v_note_field = arcpy.Parameter(            displayName="V_NOTE Source Field (optional)",            name="v_note_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        v_note_field.parameterDependencies = ["in_fc"]        ref_id_field = arcpy.Parameter(            displayName="REF_ID Source Field (optional)",            name="ref_id_field",            datatype="Field",            parameterType="Optional",            direction="Input"        )        ref_id_field.parameterDependencies = ["in_fc"]        out_workspace = arcpy.Parameter(            displayName="Output Workspace",            name="out_workspace",            datatype="Workspace",            parameterType="Required",            direction="Input"        )        return [            in_fc,            uniqueid_field,            loc_uncert,            distance_field,            map_by_input,            map_com_field,            sname_field,            est_id_field,            descriptor_field,            luc_use,            dig_base,            dig_com_field,            repacc_field,            repcom_field,            v_by_field,            v_date_field,            v_note_field,            ref_id_field,            out_workspace        ]    # ======================================================================    # UPDATE PARAMETERS    # ======================================================================    def updateParameters(self, parameters):        return    # ======================================================================    # UPDATE MESSAGES    # ======================================================================    def updateMessages(self, parameters):        in_fc = parameters[0].valueAsText        if in_fc:            try:                desc = arcpy.Describe(in_fc)                actual_shape = desc.shapeType.upper()                supported_shapes = [                    "POINT",                    "POLYLINE",                    "POLYGON"                ]                if actual_shape not in supported_shapes:                    parameters[0].setErrorMessage(                        "Unsupported geometry type '{}'. "                        "The input feature class must contain "                        "POINT, POLYLINE, or POLYGON geometry."                        .format(actual_shape)                    )            except Exception:                pass    # ======================================================================    # DATE NORMALIZATION    # ======================================================================    def normalize_v_date(self, value):        if value in (None, ""):            return None        if isinstance(value, datetime):            return value.strftime("%Y-%m-%d")        if isinstance(value, date):            return value.strftime("%Y-%m-%d")        value = str(value).strip()        if not value:            return None        date_formats = [            "%Y-%m-%d",            "%Y/%m/%d",            "%m/%d/%Y",            "%m-%d-%Y",            "%m/%d/%y",            "%m-%d-%y",            "%d/%m/%Y",            "%d-%m-%Y",            "%Y%m%d"        ]        for fmt in date_formats:            try:                parsed_date = datetime.strptime(                    value,                    fmt                )                return parsed_date.strftime(                    "%Y-%m-%d"                )            except ValueError:                continue        if " " in value:            date_part = value.split(" ")[0]            for fmt in date_formats:                try:                    parsed_date = datetime.strptime(                        date_part,                        fmt                    )                    return parsed_date.strftime(                        "%Y-%m-%d"                    )                except ValueError:                    continue        if "T" in value:            date_part = value.split("T")[0]            for fmt in date_formats:                try:                    parsed_date = datetime.strptime(                        date_part,                        fmt                    )                    return parsed_date.strftime(                        "%Y-%m-%d"                    )                except ValueError:                    continue        arcpy.AddWarning(            "V_DATE value '{}' could not be interpreted as a date. "            "V_DATE will be NULL."            .format(value)        )        return None    # ======================================================================    # GEOMETRY NORMALIZATION    #    # IMPORTANT:    #    # ArcGIS Pro can store curved polygons containing:    #    #   CIRCULARSTRING    #   COMPOUNDCURVE    #   CURVEPOLYGON    #    # Some spatial database importers interpret those as:    #    #   MULTISURFACE    #    # Shapefiles do NOT support true curve geometry.    #    # Therefore, curved polygon geometry is converted into ordinary    # straight-segment polygon geometry before it is inserted.    # ======================================================================    def normalize_geometry(        self,        geometry,        geometry_type    ):        if geometry is None:            return None        # --------------------------------------------------------------        # POINT        #        # Point geometry does not need conversion.        # --------------------------------------------------------------        if geometry_type == "POINT":            return geometry        # --------------------------------------------------------------        # POLYLINE        #        # Return the original polyline geometry.        #        # We do not convert ordinary line geometry unnecessarily.        # --------------------------------------------------------------        if geometry_type == "POLYLINE":            return geometry        # --------------------------------------------------------------        # POLYGON        #        # This is the important part.        #        # If the polygon contains curves, densify() replaces the curves        # with straight line segments.        #        # This means the resulting geometry is an ordinary Polygon        # rather than a curved polygon that can become MULTISURFACE        # during import.        # --------------------------------------------------------------        if geometry_type == "POLYGON":            try:                if getattr(geometry, "hasCurves", False):                    arcpy.AddMessage(                        "Curved polygon detected. "                        "Converting curved segments to "                        "standard straight-segment geometry."                    )                    # ANGLE method:                    #                    # Maximum angular change between vertices.                    #                    # A relatively small value preserves the shape                    # while removing true curve geometry.                    #                    # The deviation value provides an additional                    # safeguard against excessive deviation.                    #                    converted_geometry = geometry.densify(                        "ANGLE",                        1.0,                        0.1                    )                    return converted_geometry                return geometry            except Exception as geometry_error:                raise arcpy.ExecuteError(                    "Could not convert polygon geometry to "                    "standard non-curved polygon geometry. "                    "The input contains curved geometry and the "                    "conversion failed.\n\n"                    "Original error: {}"                    .format(geometry_error)                )        return geometry    # ======================================================================    # EXECUTE    # ======================================================================    def execute(self, parameters, messages):        # ------------------------------------------------------------------        # Read parameters        # ------------------------------------------------------------------        in_fc = parameters[0].valueAsText        uniqueid_field = parameters[1].valueAsText        loc_uncert_field = parameters[2].valueAsText        distance_field = parameters[3].valueAsText        map_by_input = parameters[4].valueAsText        map_com_field = parameters[5].valueAsText        sname_field = parameters[6].valueAsText        est_id_field = parameters[7].valueAsText        descriptor_field = parameters[8].valueAsText        luc_use_field = parameters[9].valueAsText        dig_base = parameters[10].valueAsText        dig_com_field = parameters[11].valueAsText        repacc_field = parameters[12].valueAsText        repcom_field = parameters[13].valueAsText        v_by_field = parameters[14].valueAsText        v_date_field = parameters[15].valueAsText        v_note_field = parameters[16].valueAsText        ref_id_field = parameters[17].valueAsText        out_workspace = parameters[18].valueAsText        # ------------------------------------------------------------------        # Validate required parameters        # ------------------------------------------------------------------        if not in_fc:            raise arcpy.ExecuteError(                "Input Feature Class is required."            )        if not uniqueid_field:            raise arcpy.ExecuteError(                "UNIQUEID Source Field is required."            )        if not est_id_field:            raise arcpy.ExecuteError(                "EST_ID Source Field is required."            )        if not out_workspace:            raise arcpy.ExecuteError(                "Output Workspace is required."            )        # ------------------------------------------------------------------        # Describe input        # ------------------------------------------------------------------        desc = arcpy.Describe(in_fc)        actual_shape = desc.shapeType.upper()        input_spatial_reference = desc.spatialReference        geometry_settings = {            "POINT": {                "output_name": "sf_point",                "create_type": "POINT",                "conc_feat": "Point",                "sf_type": "point"            },            "POLYLINE": {                "output_name": "sf_line",                "create_type": "POLYLINE",                "conc_feat": "Line",                "sf_type": "line"            },            "POLYGON": {                "output_name": "sf_poly",                "create_type": "POLYGON",                "conc_feat": "Polygon",                "sf_type": "poly"            }        }        if actual_shape not in geometry_settings:            raise arcpy.ExecuteError(                "Unsupported input geometry '{}'. "                "The input feature class must be POINT, "                "POLYLINE, or POLYGON."                .format(actual_shape)            )        geometry_info = geometry_settings[actual_shape]        sf_type_name = geometry_info["output_name"]        arcpy.AddMessage(            "Input geometry detected: {}"            .format(actual_shape)        )        arcpy.AddMessage(            "Output source feature type: {}"            .format(sf_type_name)        )        # ------------------------------------------------------------------        # MAP_BY        # ------------------------------------------------------------------        if map_by_input:            map_by_input = map_by_input.strip()            if len(map_by_input) > 20:                arcpy.AddWarning(                    "MAP_BY exceeds 20 characters and will be "                    "truncated to 20 characters."                )                map_by_input = map_by_input[:20]        else:            map_by_input = None        # ------------------------------------------------------------------        # Verify output workspace        # ------------------------------------------------------------------        if not arcpy.Exists(out_workspace):            raise arcpy.ExecuteError(                "The output workspace does not exist:\n{}"                .format(out_workspace)            )        # ------------------------------------------------------------------        # Resolve input fields ONCE.        #        # This avoids repeatedly calling ListFields and improves speed.        # ------------------------------------------------------------------        all_fields = arcpy.ListFields(in_fc)        field_lookup = {            field.name.lower(): field.name            for field in all_fields        }        field_info = {            field.name.lower(): field            for field in all_fields        }        def resolve_field(            field_name,            required=False        ):            if not field_name:                if required:                    raise arcpy.ExecuteError(                        "A required source field was not supplied."                    )                return None            resolved = field_lookup.get(                field_name.lower()            )            if not resolved:                raise arcpy.ExecuteError(                    "Source field '{}' could not be found in "                    "the input feature class."                    .format(field_name)                )            return resolved        uniqueid_f = resolve_field(            uniqueid_field,            required=True        )        sname_f = resolve_field(            sname_field        )        estid_f = resolve_field(            est_id_field,            required=True        )        loc_uncert_f = resolve_field(            loc_uncert_field        )        distance_f = resolve_field(            distance_field        )        mapcom_f = resolve_field(            map_com_field        )        desc_f = resolve_field(            descriptor_field        )        luc_use_f = resolve_field(            luc_use_field        )        digcom_f = resolve_field(            dig_com_field        )        repacc_f = resolve_field(            repacc_field        )        repcom_f = resolve_field(            repcom_field        )        vby_f = resolve_field(            v_by_field        )        vdate_f = resolve_field(            v_date_field        )        vnote_f = resolve_field(            v_note_field        )        refid_f = resolve_field(            ref_id_field        )        # ------------------------------------------------------------------        # Check numeric fields        # ------------------------------------------------------------------        numeric_types = [            "OID",            "SmallInteger",            "Integer",            "Single",            "Double",            "BigInteger"        ]        uniqueid_type = field_info[            uniqueid_f.lower()        ].type        if uniqueid_type not in numeric_types:            raise arcpy.ExecuteError(                "UNIQUEID source field '{}' is type '{}'. "                "UNIQUEID must be numeric."                .format(                    uniqueid_f,                    uniqueid_type                )            )        # ------------------------------------------------------------------        # Output paths        # ------------------------------------------------------------------        output_fc = os.path.join(            out_workspace,            sf_type_name        )        visits_table = os.path.join(            out_workspace,            "tbl_sf_visits"        )        references_table = os.path.join(            out_workspace,            "tbl_sf_references"        )        # ------------------------------------------------------------------        # Delete previous outputs        # ------------------------------------------------------------------        for output_item in [            output_fc,            visits_table,            references_table        ]:            if arcpy.Exists(output_item):                arcpy.AddMessage(                    "Deleting existing output: {}"                    .format(output_item)                )                arcpy.management.Delete(                    output_item                )        # ------------------------------------------------------------------        # Create output feature class        # ------------------------------------------------------------------        arcpy.AddMessage(            "Creating output feature class..."        )        arcpy.management.CreateFeatureclass(            out_path=out_workspace,            out_name=sf_type_name,            geometry_type=geometry_info["create_type"],            template=None,            has_m="DISABLED",            has_z="DISABLED",            spatial_reference=input_spatial_reference        )        # ------------------------------------------------------------------        # Field helpers        # ------------------------------------------------------------------        def add_text_field(            field_name,            field_length        ):            arcpy.management.AddField(                output_fc,                field_name,                "TEXT",                field_length=field_length            )        def add_double_field(            field_name        ):            arcpy.management.AddField(                output_fc,                field_name,                "DOUBLE"            )        def add_long_field(            field_name        ):            arcpy.management.AddField(                output_fc,                field_name,                "LONG"            )        # ==================================================================        # STANDARD SOURCE FEATURE FIELDS        # ==================================================================        add_double_field("UNIQUEID")        add_text_field("CONC_FEAT_", 10)        add_text_field("LOC_UNCERT", 30)        add_double_field("DISTANCE")        add_text_field("DIST_UNIT", 20)        add_text_field("MAP_BY", 20)        add_text_field("MAP_DATE", 10)        add_text_field("MAP_COM", 1000)        add_text_field("SNAME", 100)        add_double_field("EST_ID")        add_text_field("QC_BY", 20)        add_text_field("QC_STATUS", 60)        add_text_field("QC_COM", 1000)        add_text_field("DESCRIPTOR", 250)        add_text_field("LOCATOR", 250)        add_text_field("LOC_USE", 40)        add_text_field("UH_EX", 1)        add_text_field("DIG_BASE", 60)        add_text_field("DIG_COM", 1000)        add_text_field("REP_ACC", 30)        add_text_field("REP_COM", 4000)        add_double_field("OBS_AR_LEN")        add_text_field("OBS_AL_UNI", 20)        add_double_field("EO_ID")        add_text_field("EO_NEW", 25)        add_text_field("EODISTCOM", 1000)        add_text_field("EO_NEW_COM", 4000)        add_text_field("EO_MAP_BY", 20)        add_text_field("EO_MAP_DT", 30)        add_text_field("EO_QC_BY", 20)        add_text_field("EO_QC_ST", 60)        add_text_field("EO_QC_COM", 1000)        # ==================================================================        # NEW DATABASE SUPPORT FIELDS        #        # These are intentionally left NULL.        # ==================================================================        add_long_field("ORIG_PK_ID")        add_long_field("EO_SEQ_UID")        # ------------------------------------------------------------------        # Geometry measurement fields        #        # For lines:        #     SHAPE_Length        #        # For polygons:        #     SHAPE_Length        #     SHAPE_Area        #        # These are calculated from the OUTPUT geometry.        # ------------------------------------------------------------------        if actual_shape == "POLYLINE":            add_double_field("SHAPE_Length")        elif actual_shape == "POLYGON":            add_double_field("SHAPE_Length")            add_double_field("SHAPE_Area")        # ==================================================================        # INPUT CURSOR FIELDS        # ==================================================================        input_fields = [            "OID@",            "SHAPE@",            uniqueid_f        ]        optional_input_fields = []        def add_optional_field(            key,            field_name        ):            if field_name:                optional_input_fields.append(                    (key, field_name)                )                input_fields.append(                    field_name                )        add_optional_field(            "sname",            sname_f        )        add_optional_field(            "loc_uncert",            loc_uncert_f        )        add_optional_field(            "distance",            distance_f        )        add_optional_field(            "map_com",            mapcom_f        )        add_optional_field(            "est_id",            estid_f        )        add_optional_field(            "descriptor",            desc_f        )        add_optional_field(            "luc_use",            luc_use_f        )        add_optional_field(            "dig_com",            digcom_f        )        add_optional_field(            "rep_acc",            repacc_f        )        add_optional_field(            "rep_com",            repcom_f        )        # ==================================================================        # OUTPUT CURSOR FIELDS        # ==================================================================        output_fields = [            "SHAPE@",            "UNIQUEID",            "CONC_FEAT_",            "LOC_UNCERT",            "DISTANCE",            "DIST_UNIT",            "MAP_BY",            "MAP_DATE",            "MAP_COM",            "SNAME",            "EST_ID",            "QC_BY",            "QC_STATUS",            "QC_COM",            "DESCRIPTOR",            "LOCATOR",            "LOC_USE",            "UH_EX",            "DIG_BASE",            "DIG_COM",            "REP_ACC",            "REP_COM",            "OBS_AR_LEN",            "OBS_AL_UNI",            "EO_ID",            "EO_NEW",            "EODISTCOM",            "EO_NEW_COM",            "EO_MAP_BY",            "EO_MAP_DT",            "EO_QC_BY",            "EO_QC_ST",            "EO_QC_COM",            "ORIG_PK_ID",            "EO_SEQ_UID"        ]        if actual_shape == "POLYLINE":            output_fields.append(                "SHAPE_Length"            )        elif actual_shape == "POLYGON":            output_fields.append(                "SHAPE_Length"            )            output_fields.append(                "SHAPE_Area"            )        # ==================================================================        # DEFAULTS        # ==================================================================        default_loc_uncert = "Negligible"        default_luc_use = "Undetermined"        run_date = date.today().strftime(            "%Y-%m-%d"        )        # ==================================================================        # POPULATE OUTPUT FEATURE CLASS        # ==================================================================        arcpy.AddMessage(            "Populating {}..."            .format(sf_type_name)        )        feature_number = 0        curved_polygon_count = 0        with arcpy.da.SearchCursor(            in_fc,            input_fields        ) as search_cursor, arcpy.da.InsertCursor(            output_fc,            output_fields        ) as insert_cursor:            for row in search_cursor:                feature_number += 1                index = 0                oid = row[index]                index += 1                geometry = row[index]                index += 1                uniqueid_raw = row[index]                index += 1                # ----------------------------------------------------------                # Normalize geometry                # ----------------------------------------------------------                original_had_curves = (                    actual_shape == "POLYGON"                    and getattr(                        geometry,                        "hasCurves",                        False                    )                )                output_geometry = self.normalize_geometry(                    geometry,                    actual_shape                )                if original_had_curves:                    curved_polygon_count += 1                # ----------------------------------------------------------                # UNIQUEID                # ----------------------------------------------------------                try:                    uniqueid_value = (                        float(uniqueid_raw)                        if uniqueid_raw not in (None, "")                        else None                    )                except (TypeError, ValueError):                    raise arcpy.ExecuteError(                        "UNIQUEID value for OID {} is not numeric: {}"                        .format(                            oid,                            uniqueid_raw                        )                    )                # ----------------------------------------------------------                # Defaults                # ----------------------------------------------------------                sname_value = None                estid_value = None                loc_uncert_value = default_loc_uncert                distance_value = None                distance_unit_value = None                map_com_value = None                descriptor_value = None                luc_use_value = default_luc_use                dig_com_value = None                rep_acc_value = None                rep_com_value = None                # ----------------------------------------------------------                # Optional source fields                # ----------------------------------------------------------                for field_key, field_name in optional_input_fields:                    raw_value = row[index]                    index += 1                    if field_key == "sname":                        if raw_value not in (None, ""):                            sname_value = str(                                raw_value                            )[:100]                    elif field_key == "loc_uncert":                        if raw_value not in (None, ""):                            loc_uncert_value = str(                                raw_value                            )[:30]                    elif field_key == "distance":                        if raw_value not in (None, ""):                            try:                                distance_value = float(                                    raw_value                                )                                distance_unit_value = "Meters"                            except (                                TypeError,                                ValueError                            ):                                arcpy.AddWarning(                                    "DISTANCE value for OID {} "                                    "could not be converted. "                                    "DISTANCE will be NULL."                                    .format(oid)                                )                    elif field_key == "map_com":                        if raw_value not in (None, ""):                            map_com_value = str(                                raw_value                            )[:1000]                    elif field_key == "est_id":                        if raw_value not in (None, ""):                            try:                                estid_value = float(                                    raw_value                                )                            except (                                TypeError,                                ValueError                            ):                                arcpy.AddWarning(                                    "EST_ID value for OID {} "                                    "could not be converted. "                                    "EST_ID will be NULL."                                    .format(oid)                                )                    elif field_key == "descriptor":                        if raw_value not in (None, ""):                            descriptor_value = str(                                raw_value                            )[:250]                    elif field_key == "luc_use":                        if raw_value not in (None, ""):                            luc_use_value = str(                                raw_value                            )[:40]                    elif field_key == "dig_com":                        if raw_value not in (None, ""):                            dig_com_value = str(                                raw_value                            )[:1000]                    elif field_key == "rep_acc":                        if raw_value not in (None, ""):                            rep_acc_value = str(                                raw_value                            )[:30]                    elif field_key == "rep_com":                        if raw_value not in (None, ""):                            rep_com_value = str(                                raw_value                            )[:4000]                # ----------------------------------------------------------                # Calculate geometry measurements from OUTPUT geometry.                #                # This is intentional:                #                # The values represent the geometry that is actually                # being written to the output feature class.                # ----------------------------------------------------------                shape_length_value = None                shape_area_value = None                if actual_shape == "POLYLINE":                    shape_length_value = (                        output_geometry.length                    )                elif actual_shape == "POLYGON":                    shape_length_value = (                        output_geometry.length                    )                    shape_area_value = (                        output_geometry.area                    )                # ----------------------------------------------------------                # Build insert row                # ----------------------------------------------------------                insert_values = [                    output_geometry,                    uniqueid_value,                    geometry_info["conc_feat"],                    loc_uncert_value,                    distance_value,                    distance_unit_value,                    map_by_input,                    run_date,                    map_com_value,                    sname_value,                    estid_value,                    # QC_BY                    None,                    # QC_STATUS                    None,                    # QC_COM                    None,                    # DESCRIPTOR                    descriptor_value,                    # LOCATOR                    None,                    # LOC_USE                    luc_use_value,                    # UH_EX                    "N",                    # DIG_BASE                    dig_base if dig_base else None,                    # DIG_COM                    dig_com_value,                    # REP_ACC                    rep_acc_value,                    # REP_COM                    rep_com_value,                    # OBS_AR_LEN                    None,                    # OBS_AL_UNI                    None,                    # EO_ID                    None,                    # EO_NEW                    None,                    # EODISTCOM                    None,                    # EO_NEW_COM                    None,                    # EO_MAP_BY                    None,                    # EO_MAP_DT                    None,                    # EO_QC_BY                    None,                    # EO_QC_ST                    None,                    # EO_QC_COM                    None,                    # ORIG_PK_ID                    None,                    # EO_SEQ_UID                    None                ]                if actual_shape == "POLYLINE":                    insert_values.append(                        shape_length_value                    )                elif actual_shape == "POLYGON":                    insert_values.append(                        shape_length_value                    )                    insert_values.append(                        shape_area_value                    )                insert_cursor.insertRow(                    insert_values                )        # ==================================================================        # GEOMETRY VALIDATION AFTER WRITING        #        # This is an important safeguard. We read the output back and        # verify that it is still ordinary ArcGIS geometry.        # ==================================================================        arcpy.AddMessage(            "Validating output geometry..."        )        output_count = 0        with arcpy.da.SearchCursor(            output_fc,            ["OID@", "SHAPE@"]        ) as verify_cursor:            for verify_row in verify_cursor:                output_count += 1                verify_oid = verify_row[0]                verify_geometry = verify_row[1]                if verify_geometry is None:                    raise arcpy.ExecuteError(                        "Output feature OID {} has NULL geometry."                        .format(verify_oid)                    )                # ----------------------------------------------------------                # Polygon safeguard                # ----------------------------------------------------------                if actual_shape == "POLYGON":                    if getattr(                        verify_geometry,                        "hasCurves",                        False                    ):                        raise arcpy.ExecuteError(                            "Output polygon OID {} still contains "                            "curved geometry. The output cannot be "                            "used safely as a shapefile/database "                            "interchange geometry."                            .format(verify_oid)                        )        arcpy.AddMessage(            "Validated {} output feature(s)."            .format(output_count)        )        if curved_polygon_count > 0:            arcpy.AddMessage(                "{} polygon feature(s) contained curved geometry "                "and were converted to standard straight-segment "                "polygon geometry."                .format(curved_polygon_count)            )        # ==================================================================        # CREATE VISITS TABLE        # ==================================================================        arcpy.AddMessage(            "Creating tbl_sf_visits..."        )        arcpy.management.CreateTable(            out_workspace,            "tbl_sf_visits"        )        arcpy.management.AddField(            visits_table,            "V_BY",            "TEXT",            field_length=250        )        arcpy.management.AddField(            visits_table,            "V_DATE",            "TEXT",            field_length=50        )        arcpy.management.AddField(            visits_table,            "V_NOTE",            "TEXT",            field_length=2000        )        arcpy.management.AddField(            visits_table,            "SF_TYPE",            "TEXT",            field_length=10        )        arcpy.management.AddField(            visits_table,            "SF_UNIQUEID",            "LONG"        )        visit_input_fields = [            uniqueid_f        ]        visit_mapping = []        if vby_f:            visit_input_fields.append(                vby_f            )            visit_mapping.append(                "V_BY"            )        if vdate_f:            visit_input_fields.append(                vdate_f            )            visit_mapping.append(                "V_DATE"            )        if vnote_f:            visit_input_fields.append(                vnote_f            )            visit_mapping.append(                "V_NOTE"            )        # ==================================================================        # POPULATE VISITS        # ==================================================================        with arcpy.da.SearchCursor(            in_fc,            visit_input_fields        ) as visit_search, arcpy.da.InsertCursor(            visits_table,            [                "V_BY",                "V_DATE",                "V_NOTE",                "SF_TYPE",                "SF_UNIQUEID"            ]        ) as visit_insert:            for row in visit_search:                uniqueid_raw = row[0]                try:                    uniqueid_value = (                        int(float(uniqueid_raw))                        if uniqueid_raw not in (None, "")                        else None                    )                except (                    TypeError,                    ValueError                ):                    uniqueid_value = None                values = {                    "V_BY": None,                    "V_DATE": None,                    "V_NOTE": None                }                for position, field_name in enumerate(                    visit_mapping                ):                    value = row[                        position + 1                    ]                    if value not in (None, ""):                        if field_name == "V_BY":                            value = str(                                value                            )[:250]                        elif field_name == "V_DATE":                            value = self.normalize_v_date(                                value                            )                        elif field_name == "V_NOTE":                            value = str(                                value                            )[:2000]                    values[field_name] = value                visit_insert.insertRow([                    values["V_BY"],                    values["V_DATE"],                    values["V_NOTE"],                    geometry_info["sf_type"],                    uniqueid_value                ])        # ==================================================================        # REFERENCES TABLE        # ==================================================================        arcpy.AddMessage(            "Creating tbl_sf_references..."        )        arcpy.management.CreateTable(            out_workspace,            "tbl_sf_references"        )        arcpy.management.AddField(            references_table,            "REF_ID",            "DOUBLE"        )        arcpy.management.AddField(            references_table,            "REF_PRIM",            "TEXT",            field_length=1        )        arcpy.management.AddField(            references_table,            "SF_TYPE",            "TEXT",            field_length=10        )        arcpy.management.AddField(            references_table,            "SF_UNIQUEID",            "LONG"        )        reference_input_fields = [            uniqueid_f        ]        if refid_f:            reference_input_fields.append(                refid_f            )        # ==================================================================        # POPULATE REFERENCES        # ==================================================================        with arcpy.da.SearchCursor(            in_fc,            reference_input_fields        ) as reference_search, arcpy.da.InsertCursor(            references_table,            [                "REF_ID",                "REF_PRIM",                "SF_TYPE",                "SF_UNIQUEID"            ]        ) as reference_insert:            for row in reference_search:                uniqueid_raw = row[0]                try:                    uniqueid_value = (                        int(float(uniqueid_raw))                        if uniqueid_raw not in (None, "")                        else None                    )                except (                    TypeError,                    ValueError                ):                    uniqueid_value = None                ref_value = None                if len(row) > 1:                    raw_reference = row[1]                    if raw_reference not in (None, ""):                        try:                            ref_value = float(                                raw_reference                            )                        except (                            TypeError,                            ValueError                        ):                            ref_value = None                reference_insert.insertRow([                    ref_value,                    "N",                    geometry_info["sf_type"],                    uniqueid_value                ])        # ==================================================================        # FINAL MESSAGES        # ==================================================================        arcpy.AddMessage(            "--------------------------------------------------"        )        arcpy.AddMessage(            "Source Feature Modifier completed successfully."        )        arcpy.AddMessage(            "Input geometry: {}"            .format(actual_shape)        )        arcpy.AddMessage(            "Output feature class: {}"            .format(output_fc)        )        arcpy.AddMessage(            "Output feature count: {}"            .format(output_count)        )        arcpy.AddMessage(            "Curved polygons converted: {}"            .format(curved_polygon_count)        )        arcpy.AddMessage(            "ORIG_PK_ID: NULL"        )        arcpy.AddMessage(            "EO_SEQ_UID: NULL"        )        if actual_shape == "POLYLINE":            arcpy.AddMessage(                "SHAPE_Length calculated from output line geometry."            )        elif actual_shape == "POLYGON":            arcpy.AddMessage(                "SHAPE_Length and SHAPE_Area calculated from "                "output polygon geometry."            )        arcpy.AddMessage(            "Visits table: {}"            .format(visits_table)        )        arcpy.AddMessage(            "References table: {}"            .format(references_table)        )        arcpy.AddMessage(            "--------------------------------------------------"        )    # ======================================================================    # POST EXECUTE    # ======================================================================    def postExecute(self, parameters):        return