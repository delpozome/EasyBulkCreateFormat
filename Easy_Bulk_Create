    # ======================================================================
    # UPDATE PARAMETERS
    # ======================================================================

    def updateParameters(self, parameters):
        return

    # ======================================================================
    # UPDATE MESSAGES
    # ======================================================================

    def updateMessages(self, parameters):

        in_fc = parameters[0].valueAsText

        if in_fc:

            try:

                desc = arcpy.Describe(in_fc)
                actual_shape = desc.shapeType.upper()

                supported_shapes = [
                    "POINT",
                    "POLYLINE",
                    "POLYGON"
                ]

                if actual_shape not in supported_shapes:

                    parameters[0].setErrorMessage(
                        "Unsupported geometry type '{}'. "
                        "The input feature class must contain "
                        "POINT, POLYLINE, or POLYGON geometry."
                        .format(actual_shape)
                    )

            except Exception:
                pass

    # ======================================================================
    # V_DATE NORMALIZATION
    # ======================================================================

    def normalize_v_date(self, value):

        if value in (None, ""):
            return None

        if isinstance(value, datetime):
            return value.strftime("%Y-%m-%d")

        if isinstance(value, date):
            return value.strftime("%Y-%m-%d")

        value = str(value).strip()

        if not value:
            return None

        date_formats = [
            "%Y-%m-%d",
            "%Y/%m/%d",
            "%m/%d/%Y",
            "%m-%d-%Y",
            "%m/%d/%y",
            "%m-%d-%y",
            "%d/%m/%Y",
            "%d-%m-%Y",
            "%Y%m%d"
        ]

        for fmt in date_formats:

            try:

                parsed_date = datetime.strptime(
                    value,
                    fmt
                )

                return parsed_date.strftime(
                    "%Y-%m-%d"
                )

            except ValueError:
                continue

        if " " in value:

            date_part = value.split(" ")[0]

            for fmt in date_formats:

                try:

                    parsed_date = datetime.strptime(
                        date_part,
                        fmt
                    )

                    return parsed_date.strftime(
                        "%Y-%m-%d"
                    )

                except ValueError:
                    continue

        if "T" in value:

            date_part = value.split("T")[0]

            for fmt in date_formats:

                try:

                    parsed_date = datetime.strptime(
                        date_part,
                        fmt
                    )

                    return parsed_date.strftime(
                        "%Y-%m-%d"
                    )

                except ValueError:
                    continue

        arcpy.AddWarning(
            "V_DATE value '{}' could not be interpreted as a date. "
            "V_DATE will be NULL."
            .format(value)
        )

        return None

    # ======================================================================
    # EXECUTE
    # ======================================================================

    def execute(self, parameters, messages):

        # ------------------------------------------------------------------
        # Read parameters
        # ------------------------------------------------------------------

        in_fc = parameters[0].valueAsText
        uniqueid_field = parameters[1].valueAsText
        loc_uncert_field = parameters[2].valueAsText
        distance_field = parameters[3].valueAsText
        map_by_input = parameters[4].valueAsText
        map_com_field = parameters[5].valueAsText
        sname_field = parameters[6].valueAsText
        est_id_field = parameters[7].valueAsText
        descriptor_field = parameters[8].valueAsText
        luc_use_field = parameters[9].valueAsText
        dig_base = parameters[10].valueAsText
        dig_com_field = parameters[11].valueAsText
        repacc_field = parameters[12].valueAsText
        repcom_field = parameters[13].valueAsText
        v_by_field = parameters[14].valueAsText
        v_date_field = parameters[15].valueAsText
        v_note_field = parameters[16].valueAsText
        ref_id_field = parameters[17].valueAsText
        out_workspace = parameters[18].valueAsText

        # ------------------------------------------------------------------
        # Validate required parameters
        # ------------------------------------------------------------------

        if not in_fc:
            raise arcpy.ExecuteError(
                "Input Feature Class is required."
            )

        if not uniqueid_field:
            raise arcpy.ExecuteError(
                "UNIQUEID Source Field is required."
            )

        if not est_id_field:
            raise arcpy.ExecuteError(
                "EST_ID Source Field is required."
            )

        if not out_workspace:
            raise arcpy.ExecuteError(
                "Output Workspace is required."
            )

        # ------------------------------------------------------------------
        # Describe input and automatically determine geometry
        # ------------------------------------------------------------------

        desc = arcpy.Describe(in_fc)

        actual_shape = desc.shapeType.upper()
        input_workspace = desc.path
        input_spatial_reference = desc.spatialReference

        geometry_settings = {
            "POINT": {
                "output_name": "sf_point",
                "create_type": "POINT",
                "conc_feat": "Point",
                "sf_type": "point"
            },
            "POLYLINE": {
                "output_name": "sf_line",
                "create_type": "POLYLINE",
                "conc_feat": "Line",
                "sf_type": "line"
            },
            "POLYGON": {
                "output_name": "sf_poly",
                "create_type": "POLYGON",
                "conc_feat": "Polygon",
                "sf_type": "poly"
            }
        }

        if actual_shape not in geometry_settings:

            raise arcpy.ExecuteError(
                "Unsupported input geometry '{}'. "
                "The input feature class must be POINT, "
                "POLYLINE, or POLYGON."
                .format(actual_shape)
            )

        geometry_info = geometry_settings[actual_shape]

        # Automatically determined output type.
        sf_type_name = geometry_info["output_name"]

        arcpy.AddMessage(
            "Input geometry detected: {}"
            .format(actual_shape)
        )

        arcpy.AddMessage(
            "Output source feature type: {}"
            .format(sf_type_name)
        )

        # ------------------------------------------------------------------
        # MAP_BY
        # ------------------------------------------------------------------

        if map_by_input:

            map_by_input = map_by_input.strip()

            if len(map_by_input) > 20:

                arcpy.AddWarning(
                    "MAP_BY exceeds 20 characters and will be "
                    "truncated to 20 characters."
                )

                map_by_input = map_by_input[:20]

        else:

            map_by_input = None

            arcpy.AddMessage(
                "MAP_BY was not supplied. MAP_BY will be NULL."
            )

        # ------------------------------------------------------------------
        # Verify input feature geometry
        # ------------------------------------------------------------------

        expected_arc_geometry = {
            "POINT": "point",
            "POLYLINE": "polyline",
            "POLYGON": "polygon"
        }[actual_shape]

        arcpy.AddMessage(
            "Validating input feature geometries..."
        )

        feature_count = 0

        with arcpy.da.SearchCursor(
            in_fc,
            ["OID@", "SHAPE@"]
        ) as geometry_cursor:

            for geometry_row in geometry_cursor:

                feature_count += 1

                oid = geometry_row[0]
                shape = geometry_row[1]

                if shape is None:

                    raise arcpy.ExecuteError(
                        "Feature OID {} has a NULL geometry. "
                        "All input features must have valid geometry."
                        .format(oid)
                    )

                actual_feature_geometry = shape.type.lower()

                if actual_feature_geometry != expected_arc_geometry:

                    raise arcpy.ExecuteError(
                        "Feature OID {} has geometry type '{}', but "
                        "all input features must have geometry type '{}'."
                        .format(
                            oid,
                            actual_feature_geometry,
                            expected_arc_geometry
                        )
                    )

        if feature_count == 0:

            raise arcpy.ExecuteError(
                "The input feature class contains no features."
            )

        arcpy.AddMessage(
            "Validated {} input feature(s)."
            .format(feature_count)
        )

        # ------------------------------------------------------------------
        # Verify output workspace
        # ------------------------------------------------------------------

        if not arcpy.Exists(out_workspace):

            raise arcpy.ExecuteError(
                "The output workspace does not exist:\n{}"
                .format(out_workspace)
            )

        workspace_desc = arcpy.Describe(out_workspace)

        if not hasattr(workspace_desc, "workspaceType"):

            raise arcpy.ExecuteError(
                "The selected output workspace is invalid:\n{}"
                .format(out_workspace)
            )

        # ------------------------------------------------------------------
        # Resolve source fields
        # ------------------------------------------------------------------

        field_lookup = {
            field.name.lower(): field.name
            for field in arcpy.ListFields(in_fc)
        }

        field_info = {
            field.name.lower(): field
            for field in arcpy.ListFields(in_fc)
        }

        def resolve_field(field_name, required=False):

            if not field_name:

                if required:
                    raise arcpy.ExecuteError(
                        "A required source field was not supplied."
                    )

                return None

            resolved = field_lookup.get(
                field_name.lower()
            )

            if not resolved:

                raise arcpy.ExecuteError(
                    "Source field '{}' could not be found in "
                    "the input feature class."
                    .format(field_name)
                )

            return resolved

        uniqueid_f = resolve_field(
            uniqueid_field,
            required=True
        )

        # SNAME is now optional.
        sname_f = resolve_field(
            sname_field,
            required=False
        )

        estid_f = resolve_field(
            est_id_field,
            required=True
        )

        loc_uncert_f = resolve_field(
            loc_uncert_field
        )

        distance_f = resolve_field(
            distance_field
        )

        mapcom_f = resolve_field(
            map_com_field
        )

        desc_f = resolve_field(
            descriptor_field
        )

        luc_use_f = resolve_field(
            luc_use_field
        )

        digcom_f = resolve_field(
            dig_com_field
        )

        repacc_f = resolve_field(
            repacc_field
        )

        repcom_f = resolve_field(
            repcom_field
        )

        vby_f = resolve_field(
            v_by_field
        )

        vdate_f = resolve_field(
            v_date_field
        )

        vnote_f = resolve_field(
            v_note_field
        )

        refid_f = resolve_field(
            ref_id_field
        )

        # ------------------------------------------------------------------
        # Automatically determine source field data types
        # ------------------------------------------------------------------

        uniqueid_type = field_info[
            uniqueid_f.lower()
        ].type

        estid_type = field_info[
            estid_f.lower()
        ].type

        numeric_types = [
            "OID",
            "SmallInteger",
            "Integer",
            "Single",
            "Double",
            "BigInteger"
        ]

        if uniqueid_type not in numeric_types:

            raise arcpy.ExecuteError(
                "UNIQUEID source field '{}' is of type '{}'. "
                "UNIQUEID must be a numeric field."
                .format(
                    uniqueid_f,
                    uniqueid_type
                )
            )

        if estid_type not in numeric_types:

            arcpy.AddWarning(
                "EST_ID source field '{}' is type '{}'. "
                "Values will be converted to numeric values where possible."
                .format(
                    estid_f,
                    estid_type
                )
            )

        arcpy.AddMessage(
            "UNIQUEID field '{}' detected as {}."
            .format(
                uniqueid_f,
                uniqueid_type
            )
        )

        arcpy.AddMessage(
            "EST_ID field '{}' detected as {}."
            .format(
                estid_f,
                estid_type
            )
        )

        # ------------------------------------------------------------------
        # Determine output names
        # ------------------------------------------------------------------

        output_fc = os.path.join(
            out_workspace,
            sf_type_name
        )

        visits_table = os.path.join(
            out_workspace,
            "tbl_sf_visits"
        )

        references_table = os.path.join(
            out_workspace,
            "tbl_sf_references"
        )

        # ------------------------------------------------------------------
        # Delete existing outputs
        # ------------------------------------------------------------------

        outputs_to_delete = [
            output_fc,
            visits_table,
            references_table
        ]

        for output_item in outputs_to_delete:

            if arcpy.Exists(output_item):

                arcpy.AddMessage(
                    "Deleting existing output: {}"
                    .format(output_item)
                )

                arcpy.management.Delete(
                    output_item
                )

        # ------------------------------------------------------------------
        # Create output feature class
        # ------------------------------------------------------------------

        arcpy.AddMessage(
            "Creating output feature class: {}"
            .format(sf_type_name)
        )

        arcpy.management.CreateFeatureclass(
            out_path=out_workspace,
            out_name=sf_type_name,
            geometry_type=geometry_info["create_type"],
            template=None,
            has_m="DISABLED",
            has_z="DISABLED",
            spatial_reference=input_spatial_reference
        )

        # ------------------------------------------------------------------
        # Helper functions
        # ------------------------------------------------------------------

        def add_text_field(
            field_name,
            field_length
        ):

            arcpy.management.AddField(
                output_fc,
                field_name,
                "TEXT",
                field_length=field_length
            )

        def add_double_field(
            field_name
        ):

            arcpy.management.AddField(
                output_fc,
                field_name,
                "DOUBLE"
            )

        # ------------------------------------------------------------------
        # Create output fields
        # ------------------------------------------------------------------

        add_double_field("UNIQUEID")
        add_text_field("CONC_FEAT_", 10)
        add_text_field("LOC_UNCERT", 30)
        add_double_field("DISTANCE")
        add_text_field("DIST_UNIT", 20)
        add_text_field("MAP_BY", 20)
        add_text_field("MAP_DATE", 10)
        add_text_field("MAP_COM", 1000)
        add_text_field("SNAME", 100)
        add_double_field("EST_ID")

        add_text_field("QC_BY", 20)
        add_text_field("QC_STATUS", 60)
        add_text_field("QC_COM", 1000)
        add_text_field("DESCRIPTOR", 250)
        add_text_field("LOCATOR", 250)
        add_text_field("LOC_USE", 40)
        add_text_field("UH_EX", 1)
        add_text_field("DIG_BASE", 60)
        add_text_field("DIG_COM", 1000)
        add_text_field("REP_ACC", 30)
        add_text_field("REP_COM", 4000)

        add_double_field("OBS_AR_LEN")
        add_text_field("OBS_AL_UNI", 20)

        add_double_field("EO_ID")
        add_text_field("EO_NEW", 25)
        add_text_field("EODISTCOM", 1000)
        add_text_field("EO_NEW_COM", 4000)
        add_text_field("EO_MAP_BY", 20)
        add_text_field("EO_MAP_DT", 30)
        add_text_field("EO_QC_BY", 20)
        add_text_field("EO_QC_ST", 60)
        add_text_field("EO_QC_COM", 1000)

        # ------------------------------------------------------------------
        # Build input cursor fields
        # ------------------------------------------------------------------

        input_fields = [
            "OID@",
            "SHAPE@",
            uniqueid_f
        ]

        optional_input_fields = []

        def add_optional_field(
            key,
            field_name
        ):

            if field_name:

                optional_input_fields.append(
                    (key, field_name)
                )

                input_fields.append(
                    field_name
                )

        # SNAME is optional.
        add_optional_field(
            "sname",
            sname_f
        )

        add_optional_field(
            "loc_uncert",
            loc_uncert_f
        )

        add_optional_field(
            "distance",
            distance_f
        )

        add_optional_field(
            "map_com",
            mapcom_f
        )

        add_optional_field(
            "est_id",
            estid_f
        )

        add_optional_field(
            "descriptor",
            desc_f
        )

        add_optional_field(
            "luc_use",
            luc_use_f
        )

        add_optional_field(
            "dig_com",
            digcom_f
        )

        add_optional_field(
            "rep_acc",
            repacc_f
        )

        add_optional_field(
            "rep_com",
            repcom_f
        )

        # ------------------------------------------------------------------
        # Output cursor fields
        # ------------------------------------------------------------------

        output_fields = [
            "SHAPE@",
            "UNIQUEID",
            "CONC_FEAT_",
            "LOC_UNCERT",
            "DISTANCE",
            "DIST_UNIT",
            "MAP_BY",
            "MAP_DATE",
            "MAP_COM",
            "SNAME",
            "EST_ID",
            "QC_BY",
            "QC_STATUS",
            "QC_COM",
            "DESCRIPTOR",
            "LOCATOR",
            "LOC_USE",
            "UH_EX",
            "DIG_BASE",
            "DIG_COM",
            "REP_ACC",
            "REP_COM",
            "OBS_AR_LEN",
            "OBS_AL_UNI",
            "EO_ID",
            "EO_NEW",
            "EODISTCOM",
            "EO_NEW_COM",
            "EO_MAP_BY",
            "EO_MAP_DT",
            "EO_QC_BY",
            "EO_QC_ST",
            "EO_QC_COM"
        ]

        # ------------------------------------------------------------------
        # Default settings
        # ------------------------------------------------------------------

        default_loc_uncert = "Negligible"
        default_luc_use = "Undetermined"

        if loc_uncert_f:

            arcpy.AddMessage(
                "LOC_UNCERT source: {}"
                .format(loc_uncert_f)
            )

        else:

            arcpy.AddMessage(
                "LOC_UNCERT source not selected. "
                "Using 'Negligible'."
            )

        if luc_use_f:

            arcpy.AddMessage(
                "LUC_USE source: {}"
                .format(luc_use_f)
            )

        else:

            arcpy.AddMessage(
                "LUC_USE was not populated; it will be "
                "set to 'Undetermined'."
            )

        if distance_f:

            arcpy.AddMessage(
                "DISTANCE source: {}"
                .format(distance_f)
            )

        else:

            arcpy.AddMessage(
                "DISTANCE source not selected. "
                "DISTANCE will be NULL."
            )

        if dig_base:

            arcpy.AddMessage(
                "DIG_BASE: {}"
                .format(dig_base)
            )

        else:

            arcpy.AddMessage(
                "DIG_BASE was not selected. "
                "DIG_BASE will be NULL."
            )

        if sname_f:

            arcpy.AddMessage(
                "SNAME source: {}"
                .format(sname_f)
            )

        else:

            arcpy.AddMessage(
                "SNAME source not selected. SNAME will be NULL."
            )

        # ------------------------------------------------------------------
        # Populate output feature class
        # ------------------------------------------------------------------

        arcpy.AddMessage(
            "Populating {}..."
            .format(sf_type_name)
        )

        run_date = date.today().strftime(
            "%Y-%m-%d"
        )

        feature_number = 0

        with arcpy.da.SearchCursor(
            in_fc,
            input_fields
        ) as search_cursor, arcpy.da.InsertCursor(
            output_fc,
            output_fields
        ) as insert_cursor:

            for row in search_cursor:

                feature_number += 1

                index = 0

                # ----------------------------------------------------------
                # Base fields
                # ----------------------------------------------------------

                oid = row[index]
                index += 1

                geometry = row[index]
                index += 1

                uniqueid_raw = row[index]
                index += 1

                # ----------------------------------------------------------
                # Defaults
                # ----------------------------------------------------------

                sname_value = None
                estid_value = None

                loc_uncert_value = default_loc_uncert

                distance_value = None
                distance_unit_value = None

                map_com_value = None
                descriptor_value = None

                luc_use_value = default_luc_use

                dig_com_value = None

                rep_acc_value = None
                rep_com_value = None

                # ----------------------------------------------------------
                # UNIQUEID
                # ----------------------------------------------------------

                try:

                    uniqueid_value = (
                        float(uniqueid_raw)
                        if uniqueid_raw not in (None, "")
                        else None
                    )

                except (TypeError, ValueError):

                    raise arcpy.ExecuteError(
                        "UNIQUEID value for OID {} is not numeric: {}"
                        .format(
                            oid,
                            uniqueid_raw
                        )
                    )

                # ----------------------------------------------------------
                # Read optional fields
                # ----------------------------------------------------------

                for field_key, field_name in optional_input_fields:

                    raw_value = row[index]
                    index += 1

                    # ------------------------------------------------------
                    # SNAME
                    # ------------------------------------------------------

                    if field_key == "sname":

                        if raw_value not in (None, ""):

                            sname_value = str(
                                raw_value
                            )[:100]

                    # ------------------------------------------------------
                    # LOC_UNCERT
                    # ------------------------------------------------------

                    elif field_key == "loc_uncert":

                        if raw_value not in (None, ""):

                            loc_uncert_value = str(
                                raw_value
                            )[:30]

                    # ------------------------------------------------------
                    # DISTANCE
                    # ------------------------------------------------------

                    elif field_key == "distance":

                        if raw_value not in (None, ""):

                            try:

                                distance_value = float(
                                    raw_value
                                )

                                distance_unit_value = "Meters"

                            except (TypeError, ValueError):

                                arcpy.AddWarning(
                                    "DISTANCE value for OID {} could "
                                    "not be converted to a number. "
                                    "DISTANCE will be NULL."
                                    .format(oid)
                                )

                                distance_value = None
                                distance_unit_value = None

                    # ------------------------------------------------------
                    # MAP_COM
                    # ------------------------------------------------------

                    elif field_key == "map_com":

                        if raw_value not in (None, ""):

                            map_com_value = str(
                                raw_value
                            )[:1000]

                    # ------------------------------------------------------
                    # EST_ID
                    # ------------------------------------------------------

                    elif field_key == "est_id":

                        if raw_value not in (None, ""):

                            try:

                                estid_value = float(
                                    raw_value
                                )

                            except (TypeError, ValueError):

                                arcpy.AddWarning(
                                    "EST_ID value for OID {} could not "
                                    "be converted to a number. EST_ID "
                                    "will be NULL."
                                    .format(oid)
                                )

                                estid_value = None

                    # ------------------------------------------------------
                    # DESCRIPTOR
                    # ------------------------------------------------------

                    elif field_key == "descriptor":

                        if raw_value not in (None, ""):

                            descriptor_value = str(
                                raw_value
                            )[:250]

                    # ------------------------------------------------------
                    # LUC_USE
                    # ------------------------------------------------------

                    elif field_key == "luc_use":

                        if raw_value not in (None, ""):

                            luc_use_value = str(
                                raw_value
                            )[:40]

                    # ------------------------------------------------------
                    # DIG_COM
                    # ------------------------------------------------------

                    elif field_key == "dig_com":

                        if raw_value not in (None, ""):

                            dig_com_value = str(
                                raw_value
                            )[:1000]

                    # ------------------------------------------------------
                    # REP_ACC
                    # ------------------------------------------------------

                    elif field_key == "rep_acc":

                        if raw_value not in (None, ""):

                            rep_acc_value = str(
                                raw_value
                            )[:30]

                    # ------------------------------------------------------
                    # REP_COM
                    # ------------------------------------------------------

                    elif field_key == "rep_com":

                        if raw_value not in (None, ""):

                            rep_com_value = str(
                                raw_value
                            )[:4000]

                # ----------------------------------------------------------
                # Insert feature
                # ----------------------------------------------------------

                insert_cursor.insertRow([
                    geometry,
                    uniqueid_value,
                    geometry_info["conc_feat"],
                    loc_uncert_value,
                    distance_value,
                    distance_unit_value,
                    map_by_input,
                    run_date,
                    map_com_value,
                    sname_value,
                    estid_value,

                    # QC_BY
                    None,

                    # QC_STATUS
                    None,

                    # QC_COM
                    None,

                    # DESCRIPTOR
                    descriptor_value,

                    # LOCATOR
                    None,

                    # LOC_USE
                    luc_use_value,

                    # UH_EX
                    "N",

                    # DIG_BASE
                    dig_base if dig_base else None,

                    # DIG_COM
                    dig_com_value,

                    # REP_ACC
                    rep_acc_value,

                    # REP_COM
                    rep_com_value,

                    # OBS_AR_LEN
                    None,

                    # OBS_AL_UNI
                    None,

                    # EO_ID
                    None,

                    # EO_NEW
                    None,

                    # EODISTCOM
                    None,

                    # EO_NEW_COM
                    None,

                    # EO_MAP_BY
                    None,

                    # EO_MAP_DT
                    None,

                    # EO_QC_BY
                    None,

                    # EO_QC_ST
                    None,

                    # EO_QC_COM
                    None
                ])

        # ==================================================================
        # CREATE VISITS TABLE
        # ==================================================================

        arcpy.AddMessage(
            "Creating tbl_sf_visits..."
        )

        arcpy.management.CreateTable(
            out_workspace,
            "tbl_sf_visits"
        )

        arcpy.management.AddField(
            visits_table,
            "V_BY",
            "TEXT",
            field_length=250
        )

        arcpy.management.AddField(
            visits_table,
            "V_DATE",
            "TEXT",
            field_length=50
        )

        arcpy.management.AddField(
            visits_table,
            "V_NOTE",
            "TEXT",
            field_length=2000
        )

        arcpy.management.AddField(
            visits_table,
            "SF_TYPE",
            "TEXT",
            field_length=10
        )

        arcpy.management.AddField(
            visits_table,
            "SF_UNIQUEID",
            "LONG"
        )

        # ------------------------------------------------------------------
        # Visits input fields
        # ------------------------------------------------------------------

        visit_input_fields = [
            "OID@",
            uniqueid_f
        ]

        visit_mapping = []

        if vby_f:

            visit_input_fields.append(
                vby_f
            )

            visit_mapping.append(
                "V_BY"
            )

        if vdate_f:

            visit_input_fields.append(
                vdate_f
            )

            visit_mapping.append(
                "V_DATE"
            )

        if vnote_f:

            visit_input_fields.append(
                vnote_f
            )

            visit_mapping.append(
                "V_NOTE"
            )

        # ------------------------------------------------------------------
        # Populate visits table
        # ------------------------------------------------------------------

        arcpy.AddMessage(
            "Populating tbl_sf_visits..."
        )

        with arcpy.da.SearchCursor(
            in_fc,
            visit_input_fields
        ) as visit_search, arcpy.da.InsertCursor(
            visits_table,
            [
                "V_BY",
                "V_DATE",
                "V_NOTE",
                "SF_TYPE",
                "SF_UNIQUEID"
            ]
        ) as visit_insert:

            for row in visit_search:

                uniqueid_raw = row[1]

                try:

                    uniqueid_value = (
                        int(float(uniqueid_raw))
                        if uniqueid_raw not in (None, "")
                        else None
                    )

                except (TypeError, ValueError):

                    uniqueid_value = None

                    arcpy.AddWarning(
                        "Could not convert UNIQUEID for visit "
                        "record associated with OID {}."
                        .format(row[0])
                    )

                values = {
                    "V_BY": None,
                    "V_DATE": None,
                    "V_NOTE": None
                }

                for position, field_name in enumerate(
                    visit_mapping
                ):

                    value = row[
                        position + 2
                    ]

                    if value not in (None, ""):

                        if field_name == "V_BY":

                            value = str(
                                value
                            )[:250]

                        elif field_name == "V_DATE":

                            value = self.normalize_v_date(value)

                        elif field_name == "V_NOTE":

                            value = str(
                                value
                            )[:2000]

                    values[field_name] = value

                visit_insert.insertRow([
                    values["V_BY"],
                    values["V_DATE"],
                    values["V_NOTE"],
                    geometry_info["sf_type"],
                    uniqueid_value
                ])

        # ==================================================================
        # CREATE REFERENCES TABLE
        # ==================================================================

        arcpy.AddMessage(
            "Creating tbl_sf_references..."
        )

        arcpy.management.CreateTable(
            out_workspace,
            "tbl_sf_references"
        )

        arcpy.management.AddField(
            references_table,
            "REF_ID",
            "DOUBLE"
        )

        arcpy.management.AddField(
            references_table,
            "REF_PRIM",
            "TEXT",
            field_length=1
        )

        arcpy.management.AddField(
            references_table,
            "SF_TYPE",
            "TEXT",
            field_length=10
        )

        arcpy.management.AddField(
            references_table,
            "SF_UNIQUEID",
            "LONG"
        )

        # ------------------------------------------------------------------
        # References input fields
        # ------------------------------------------------------------------

        reference_input_fields = [
            "OID@",
            uniqueid_f
        ]

        if refid_f:

            reference_input_fields.append(
                refid_f
            )

        # ------------------------------------------------------------------
        # Populate references table
        # ------------------------------------------------------------------

        arcpy.AddMessage(
            "Populating tbl_sf_references..."
        )

        with arcpy.da.SearchCursor(
            in_fc,
            reference_input_fields
        ) as reference_search, arcpy.da.InsertCursor(
            references_table,
            [
                "REF_ID",
                "REF_PRIM",
                "SF_TYPE",
                "SF_UNIQUEID"
            ]
        ) as reference_insert:

            for row in reference_search:

                uniqueid_raw = row[1]

                try:

                    uniqueid_value = (
                        int(float(uniqueid_raw))
                        if uniqueid_raw not in (None, "")
                        else None
                    )

                except (TypeError, ValueError):

                    uniqueid_value = None

                    arcpy.AddWarning(
                        "Could not convert UNIQUEID for reference "
                        "record associated with OID {}."
                        .format(row[0])
                    )

                ref_value = None

                if len(row) > 2:

                    raw_reference = row[2]

                    if raw_reference not in (None, ""):

                        try:

                            ref_value = float(
                                raw_reference
                            )

                        except (TypeError, ValueError):

                            arcpy.AddWarning(
                                "REF_ID value for OID {} could not "
                                "be converted to a number. "
                                "REF_ID will be NULL."
                                .format(row[0])
                            )

                            ref_value = None

                reference_insert.insertRow([
                    ref_value,
                    "N",
                    geometry_info["sf_type"],
                    uniqueid_value
                ])

        # ==================================================================
        # FINAL OUTPUT MESSAGES
        # ==================================================================

        arcpy.AddMessage(
            "--------------------------------------------------"
        )

        arcpy.AddMessage(
            "Source Feature Modifier completed successfully."
        )

        arcpy.AddMessage(
            "Input geometry: {}"
            .format(actual_shape)
        )

        arcpy.AddMessage(
            "Output feature class: {}"
            .format(output_fc)
        )


        arcpy.AddMessage(
            "Visits table: {}"
            .format(visits_table)
        )

        arcpy.AddMessage(
            "References table: {}"
            .format(references_table)
        )

        arcpy.AddMessage(
            "--------------------------------------------------"
        )

    def postExecute(self, parameters):
        return

