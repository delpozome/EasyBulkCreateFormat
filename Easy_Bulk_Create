# -*- coding: utf-8 -*-

import arcpy
import os
from datetime import date, datetime


class Toolbox:
    def __init__(self):
        self.label = "Source Feature Modifier"
        self.alias = "source_modifier"
        self.tools = [Tool]


class Tool:
    def __init__(self):
        self.label = "Create source feature, visit and reference table"
        self.description = (
            "Creates sf_line, sf_point, or sf_poly automatically from "
            "the geometry of an input feature class. "
            "Populates source feature fields and related visit/reference tables."
        )

