#Version Date 2026-08-18
#This tool allows you to cross walk a point feature layer into the bulk create format. It outputs sf_point, tbl_visit and tbl_reference. It assumes the SF uncertainty is 100m and it adds U21VMN01VAUS as a second reference to all entries.

# -*- coding: utf-8 -*-

import arcpy
import os
from datetime import date

class Toolbox:
    def __init__(self):
        self.label = "Source Feature Modifier"
        self.alias = "source_modifier"
        self.tools = [Tool]


class Tool:
    def __init__(self):
        self.label = "Create sf_point from Source"
        self.description = (
            "Creates a new point feature class 'sf_point' with specified schema, "
            "populates key fields (MAP_BY custom text, MAP_DATE, optional MAP_COM, SNAME, EST_ID from input field), "
            "initializes remaining fields to NULL (except UH_EX='N' and DIG_BASE='GPS:>10m'), and "
            "creates two standalone tables: tbl_sf_visits and tbl_sf_references."
        )

    def getParameterInfo(self):

        in_fc = arcpy.Parameter(
            displayName="Input Point Feature Class",
            name="in_fc",
            datatype="Feature Class",
            parameterType="Required",
            direction="Input"
        )

        # MAP_BY is REQUIRED custom text (no field option)
        map_by_input = arcpy.Parameter(
            displayName="MAP_BY (Required Custom Text, max 20 chars)",
            name="map_by_input",
            datatype="String",
            parameterType="Required",
            direction="Input"
        )

        # MAP_COM from an existing field (optional)
        map_com_field = arcpy.Parameter(
            displayName="MAP_COM Source Field (optional)",
            name="map_com_field",
            datatype="Field",
            parameterType="Optional",
            direction="Input"
        )
        map_com_field.parameterDependencies = ["in_fc"]

        # DIG_COM from an existing field (optional)
        dig_com_field = arcpy.Parameter(
            displayName="DIG_COM Source Field (optional)",
            name="dig_com_field",
            datatype="Field",
            parameterType="Optional",
            direction="Input"
        )
        dig_com_field.parameterDependencies = ["in_fc"]

        # SNAME source field (required)
        sname_field = arcpy.Parameter(
            displayName="SNAME Source Field (Scientific Name, required)",
            name="sname_field",
            datatype="Field",
            parameterType="Required",
            direction="Input"
        )
        sname_field.parameterDependencies = ["in_fc"]

        # EST_ID source field (required) - from input point feature class
        est_id_field = arcpy.Parameter(
            displayName="EST_ID Source Field (required, numeric preferred)",
            name="est_id_field",
            datatype="Field",
            parameterType="Required",
            direction="Input"
        )
        est_id_field.parameterDependencies = ["in_fc"]

        # tbl_sf_visits field sources (optional)
        v_by_field = arcpy.Parameter(
            displayName="Visits: V_BY Source Field (optional)",
            name="v_by_field",
            datatype="Field",
            parameterType="Optional",
            direction="Input"
        )
        v_by_field.parameterDependencies = ["in_fc"]

        v_date_field = arcpy.Parameter(
            displayName="Visits: V_DATE Source Field (optional)",
            name="v_date_field",
            datatype="Field",
            parameterType="Optional",
            direction="Input"
        )
        v_date_field.parameterDependencies = ["in_fc"]

        v_note_field = arcpy.Parameter(
            displayName="Visits: V_NOTE Source Field (optional)",
            name="v_note_field",
            datatype="Field",
            parameterType="Optional",
            direction="Input"
        )
        v_note_field.parameterDependencies = ["in_fc"]

        # tbl_sf_references REF_ID source (optional)
        ref_id_field = arcpy.Parameter(
            displayName="References: REF_ID Source Field (optional)",
            name="ref_id_field",
            datatype="Field",
            parameterType="Optional",
            direction="Input"
        )
        ref_id_field.parameterDependencies = ["in_fc"]

        out_fc = arcpy.Parameter(
            displayName="Output Feature Class (sf_point)",
            name="out_fc",
            datatype="Feature Class",
            parameterType="Derived",
            direction="Output"
        )

        return [
            in_fc, map_by_input, map_com_field, dig_com_field,
            sname_field, est_id_field,
            v_by_field, v_date_field, v_note_field, ref_id_field, out_fc
        ]

    def isLicensed(self):
        return True

    def updateParameters(self, parameters):
        return

    def updateMessages(self, parameters):
        return

    def execute(self, parameters, messages):

        in_fc = parameters[0].valueAsText
        map_by_input = parameters[1].valueAsText.strip() if parameters[1].valueAsText else ""
        map_com_field = parameters[2].valueAsText
        dig_com_field = parameters[3].valueAsText
        sname_field = parameters[4].valueAsText
        est_id_field = parameters[5].valueAsText
        v_by_field = parameters[6].valueAsText
        v_date_field = parameters[7].valueAsText
        v_note_field = parameters[8].valueAsText
        ref_id_field = parameters[9].valueAsText

        # Validate required inputs
        if not sname_field:
            raise arcpy.ExecuteError("SNAME Source Field is required. Please select a field from the input feature class.")
        if not est_id_field:
            raise arcpy.ExecuteError("EST_ID Source Field is required. Please select a field from the input feature class.")

        # Validate MAP_BY: required custom text
        if not map_by_input:
            raise arcpy.ExecuteError("MAP_BY is required. Please provide custom text (max 20 characters).")
        map_by_input = str(map_by_input)
        if len(map_by_input) > 20:
            arcpy.AddWarning("MAP_BY exceeds 20 characters; truncating to 20.")
            map_by_input = map_by_input[:20]
        arcpy.AddMessage(f"MAP_BY will use required custom text: '{map_by_input}'")

        desc = arcpy.Describe(in_fc)
        in_sr = desc.spatialReference
        in_workspace = desc.path

        out_name = "sf_point"
        out_fc = os.path.join(in_workspace, out_name)

        # Delete existing outputs if present
        for path in [out_fc,
                     os.path.join(in_workspace, "tbl_sf_visits"),
                     os.path.join(in_workspace, "tbl_sf_references")]:
            if arcpy.Exists(path):
                arcpy.Delete_management(path)

        # Create empty 2D point FC
        arcpy.CreateFeatureclass_management(
            out_path=in_workspace,
            out_name=out_name,
            geometry_type="POINT",
            has_m="DISABLED",
            has_z="DISABLED",
            spatial_reference=in_sr
        )

        # -------------------------
        # Field creation (schema)
        # -------------------------

        def add_text(name, length, nullable=True):
            arcpy.AddField_management(out_fc, name, "TEXT", field_length=length,
                                      field_is_nullable=("NULLABLE" if nullable else "NON_NULLABLE"))

        def add_double(name, nullable=True):
            arcpy.AddField_management(out_fc, name, "DOUBLE",
                                      field_is_nullable=("NULLABLE" if nullable else "NON_NULLABLE"))

        def add_long(name, nullable=True):
            arcpy.AddField_management(out_fc, name, "LONG",
                                      field_is_nullable=("NULLABLE" if nullable else "NON_NULLABLE"))

        # First columns with exact types and intended values
        arcpy.AddField_management(out_fc, "UNIQUEID", "DOUBLE", field_is_nullable="NULLABLE")
        add_text("CONC_FEAT_", 10, True)                # "Point"
        add_text("LOC_UNCERT", 30, False)               # "Estimated", NON-NULLABLE
        add_double("DISTANCE", True)                    # 100.0
        add_text("DIST_UNIT", 20, True)                 # "Meters"
        add_text("MAP_BY", 20, True)                    # REQUIRED custom text
        add_text("MAP_DATE", 10, True)                  # "YYYY-MM-DD"
        add_text("MAP_COM", 1000, True)                 # optional; left NULL if not provided
        add_text("SNAME", 100, True)                    # Scientific Name (from input field)
        add_double("EST_ID", True)                      # EST_ID from input field (DOUBLE)

        # Additional fields (per your prior spec)
        add_text("QC_BY",       20,  True)
        add_text("QC_STATUS",   60,  True)
        add_text("QC_COM",    1000,  True)
        add_text("DESCRIPTOR", 250,  True)
        add_text("LOCATOR",    250,  True)
        add_text("LOC_USE",     40,  True)
        add_text("UH_EX",        1,  True)              # "N"
        add_text("DIG_BASE",     60,  True)             # "GPS:>10m"
        add_text("DIG_COM",   1000,  True)              # optional source field
        add_text("REP_ACC",      30,  True)
        add_text("REP_COM",    4000, True)
        add_double("OBS_AR_LEN", True)
        add_text("OBS_AL_UNI",   20,  True)
        add_double("EO_ID",       True)                 # EO_ID as DOUBLE
        add_text("EO_NEW",       25,  True)
        add_text("EODISTCOM",  1000,  True)
        add_text("EO_NEW_COM", 4000,  True)
        add_text("EO_MAP_BY",    20,  True)
        add_text("EO_MAP_DT",    30,  True)
        add_text("EO_QC_BY",     20,  True)
        add_text("EO_QC_ST",     60,  True)
        add_text("EO_QC_COM",  1000,  True)

        # -------------------------
        # Create standalone tables
        # -------------------------
        visits_name = "tbl_sf_visits"
        visits_path = os.path.join(in_workspace, visits_name)
        arcpy.CreateTable_management(in_workspace, visits_name)
        arcpy.AddField_management(visits_path, "V_BY", "TEXT", field_length=250, field_is_nullable="NULLABLE")
        arcpy.AddField_management(visits_path, "V_DATE", "TEXT", field_length=50, field_is_nullable="NULLABLE")
        arcpy.AddField_management(visits_path, "V_NOTE", "TEXT", field_length=2000, field_is_nullable="NULLABLE")
        arcpy.AddField_management(visits_path, "SF_TYPE", "TEXT", field_length=10, field_is_nullable="NON_NULLABLE")
        arcpy.AddField_management(visits_path, "SF_UNIQUEID", "LONG", field_is_nullable="NON_NULLABLE")

        refs_name = "tbl_sf_references"
        refs_path = os.path.join(in_workspace, refs_name)
        arcpy.CreateTable_management(in_workspace, refs_name)
        arcpy.AddField_management(refs_path, "REF_ID", "DOUBLE", field_is_nullable="NULLABLE")
        arcpy.AddField_management(refs_path, "REF_PRIM", "TEXT", field_length=1, field_is_nullable="NON_NULLABLE")
        arcpy.AddField_management(refs_path, "SF_TYPE", "TEXT", field_length=10, field_is_nullable="NON_NULLABLE")
        arcpy.AddField_management(refs_path, "SF_UNIQUEID", "LONG", field_is_nullable="NON_NULLABLE")

        # -------------------------
        # Value preparation helpers
        # -------------------------
        # Case-insensitive field name resolution for input FC (for convenience)
        field_lookup_fc = {f.name.lower(): f.name for f in arcpy.ListFields(in_fc)}
        def resolve_fc_field(opt_name):
            return field_lookup_fc.get(opt_name.lower(), opt_name) if opt_name else None

        # Resolve provided source fields (FC)
        sname_fieldname   = resolve_fc_field(sname_field)     # required
        est_id_fieldname  = resolve_fc_field(est_id_field)    # required
        map_com_fieldname = resolve_fc_field(map_com_field)   # optional
        dig_com_fieldname = resolve_fc_field(dig_com_field)   # optional
        v_by_fieldname    = resolve_fc_field(v_by_field)      # optional
        v_date_fieldname  = resolve_fc_field(v_date_field)    # optional
        v_note_fieldname  = resolve_fc_field(v_note_field)    # optional
        ref_id_fieldname  = resolve_fc_field(ref_id_field)    # optional

        arcpy.AddMessage(f"SNAME will use values from field: {sname_fieldname}")
        arcpy.AddMessage(f"EST_ID will use values from field: {est_id_fieldname} (converted to DOUBLE; non-numeric set to NULL)")
        if map_com_fieldname:
            arcpy.AddMessage(f"MAP_COM will use values from field: {map_com_fieldname}")
        else:
            arcpy.AddMessage("MAP_COM not provided; values will be left NULL.")
        if dig_com_fieldname:
            arcpy.AddMessage(f"DIG_COM will use values from field: {dig_com_fieldname}")
        else:
            arcpy.AddMessage("DIG_COM source not provided; values will be left NULL.")

        # Run date for MAP_DATE (YYYY-MM-DD)
        run_date_str = date.today().strftime("%Y-%m-%d")

        # -------------------------
        # PASS 1: Insert into sf_point (only one writer cursor open)
        # -------------------------
        in_fields_fc = ["OID@", "SHAPE@XY", sname_fieldname, est_id_fieldname]
        if map_com_fieldname:
            in_fields_fc.append(map_com_fieldname)
        if dig_com_fieldname:
            in_fields_fc.append(dig_com_fieldname)

        out_fields_fc = [
            # First columns
            "SHAPE@", "UNIQUEID", "CONC_FEAT_", "LOC_UNCERT", "DISTANCE",
            "DIST_UNIT", "MAP_BY", "MAP_DATE", "MAP_COM", "SNAME", "EST_ID",
            # Additional
            "QC_BY", "QC_STATUS", "QC_COM", "DESCRIPTOR", "LOCATOR", "LOC_USE",
            "UH_EX", "DIG_BASE", "DIG_COM", "REP_ACC", "REP_COM",
            "OBS_AR_LEN", "OBS_AL_UNI", "EO_ID", "EO_NEW", "EODISTCOM",
            "EO_NEW_COM", "EO_MAP_BY", "EO_MAP_DT", "EO_QC_BY", "EO_QC_ST", "EO_QC_COM"
        ]

        with arcpy.da.SearchCursor(in_fc, in_fields_fc) as s_cur, \
             arcpy.da.InsertCursor(out_fc, out_fields_fc) as i_cur:

            for row in s_cur:
                idx = 0
                oid = row[idx]; idx += 1
                xy = row[idx]; idx += 1

                if xy is None:
                    continue

                # SNAME source (required)
                sname_val = row[idx]; idx += 1

                # EST_ID source (required) -> convert to float or NULL
                est_id_raw = row[idx]; idx += 1
                est_id_val = None
                if est_id_raw is not None:
                    try:
                        est_id_val = float(est_id_raw)
                    except Exception:
                        arcpy.AddWarning(f"EST_ID value for OID {oid} is not numeric ('{est_id_raw}'); setting NULL.")

                # MAP_COM source (optional)
                if map_com_fieldname:
                    map_com_val = row[idx]; idx += 1
                else:
                    map_com_val = None

                # DIG_COM source (optional)
                if dig_com_fieldname:
                    dig_com_val = row[idx]; idx += 1
                else:
                    dig_com_val = None

                # Geometry (2D)
                geom_2d = arcpy.PointGeometry(arcpy.Point(xy[0], xy[1]), in_sr, has_z=False)

                # MAP_BY value is required custom text (already validated & truncated)
                map_by_val = map_by_input

                # MAP_COM value with truncation & warning
                map_com_val = None if map_com_val is None else str(map_com_val)
                if map_com_val and len(map_com_val) > 1000:
                    arcpy.AddWarning(f"MAP_COM value for OID {oid} exceeds 1000 chars; truncating.")
                    map_com_val = map_com_val[:1000]

                # DIG_COM value with truncation & warning
                dig_com_val = None if dig_com_val is None else str(dig_com_val)
                if dig_com_val and len(dig_com_val) > 1000:
                    arcpy.AddWarning(f"DIG_COM value for OID {oid} exceeds 1000 chars; truncating.")
                    dig_com_val = dig_com_val[:1000]

                # SNAME (truncate to 100 chars for output)
                sname_text_out = None if sname_val is None else str(sname_val)
                if sname_text_out and len(sname_text_out) > 100:
                    arcpy.AddWarning(f"SNAME value for OID {oid} exceeds 100 chars; truncating.")
                    sname_text_out = sname_text_out[:100]

                # Insert into sf_point — ensure count equals len(out_fields_fc) == 33
                i_cur.insertRow([
                    geom_2d,             # SHAPE@
                    float(oid),          # UNIQUEID (DOUBLE)
                    "Point",             # CONC_FEAT_ (TEXT 10)
                    "Estimated",         # LOC_UNCERT (TEXT 30, NON-NULLABLE)
                    100.0,               # DISTANCE (DOUBLE)
                    "Meters",            # DIST_UNIT (TEXT 20)
                    map_by_val,          # MAP_BY (TEXT 20)
                    run_date_str,        # MAP_DATE (TEXT 10, YYYY-MM-DD)
                    map_com_val,         # MAP_COM (TEXT 1000) or NULL
                    sname_text_out,      # SNAME (TEXT 100, truncated)
                    est_id_val,          # EST_ID (DOUBLE or NULL)

                    None, None, None, None, None, None,   # QC_BY, QC_STATUS, QC_COM, DESCRIPTOR, LOCATOR, LOC_USE
                    "N",                                  # UH_EX (TEXT 1)
                    "GPS:>10m",                           # DIG_BASE (TEXT 60)
                    dig_com_val,                          # DIG_COM (TEXT 1000)
                    None, None,                           # REP_ACC, REP_COM
                    None, None,                           # OBS_AR_LEN (DOUBLE), OBS_AL_UNI (TEXT 20)
                    None, None, None,                     # EO_ID (DOUBLE), EO_NEW, EODISTCOM
                    None, None, None, None, None, None    # EO_NEW_COM, EO_MAP_BY, EO_MAP_DT, EO_QC_BY, EO_QC_ST, EO_QC_COM
                ])

        # -------------------------
        # PASS 2: Insert into tbl_sf_visits
        # -------------------------
        in_fields_vis = ["OID@"]
        vis_sources = []
        if v_by_fieldname:
            in_fields_vis.append(v_by_fieldname); vis_sources.append(("V_BY", v_by_fieldname))
        if v_date_fieldname:
            in_fields_vis.append(v_date_fieldname); vis_sources.append(("V_DATE", v_date_fieldname))
        if v_note_fieldname:
            in_fields_vis.append(v_note_fieldname); vis_sources.append(("V_NOTE", v_note_fieldname))

        visits_fields = ["V_BY", "V_DATE", "V_NOTE", "SF_TYPE", "SF_UNIQUEID"]

        with arcpy.da.SearchCursor(in_fc, in_fields_vis) as s_vis, \
             arcpy.da.InsertCursor(visits_path, visits_fields) as v_cur:

            for row in s_vis:
                oid = row[0]
                extracted = {}
                for i, (key, _) in enumerate(vis_sources):
                    extracted[key] = row[1 + i]

                v_by_val = extracted.get("V_BY")
                if v_by_val is not None:
                    v_by_val = str(v_by_val)
                    if len(v_by_val) > 250:
                        arcpy.AddWarning(f"V_BY value for OID {oid} exceeds 250 chars; truncating.")
                    v_by_val = v_by_val[:250]

                v_date_val = extracted.get("V_DATE")
                if v_date_val is not None:
                    v_date_val = str(v_date_val)
                    if len(v_date_val) > 50:
                        arcpy.AddWarning(f"V_DATE value for OID {oid} exceeds 50 chars; truncating.")
                    v_date_val = v_date_val[:50]

                v_note_val = extracted.get("V_NOTE")
                if v_note_val is not None:
                    v_note_val = str(v_note_val)
                    if len(v_note_val) > 2000:
                        arcpy.AddWarning(f"V_NOTE value for OID {oid} exceeds 2000 chars; truncating.")
                    v_note_val = v_note_val[:2000]

                v_cur.insertRow([
                    v_by_val,              # V_BY (TEXT 250) or NULL
                    v_date_val,            # V_DATE (TEXT 50) or NULL
                    v_note_val,            # V_NOTE (TEXT 2000) or NULL
                    "point",               # SF_TYPE (TEXT 10, lowercase)
                    int(oid)               # SF_UNIQUEID (LONG)
                ])

        # -------------------------
        # PASS 3: Insert into tbl_sf_references
        # -------------------------
        in_fields_refs = ["OID@"]
        if ref_id_fieldname:
            in_fields_refs.append(ref_id_fieldname)

        refs_fields = ["REF_ID", "REF_PRIM", "SF_TYPE", "SF_UNIQUEID"]

        with arcpy.da.SearchCursor(in_fc, in_fields_refs) as s_ref, \
             arcpy.da.InsertCursor(refs_path, refs_fields) as r_cur:

            for row in s_ref:
                oid = row[0]

                # First reference: from input field (if present)
                ref_id_val = None
                if ref_id_fieldname:
                    ref_id_val = row[1]
                    if ref_id_val is not None:
                        try:
                            ref_id_val = float(ref_id_val)
                        except Exception:
                            arcpy.AddWarning(
                                f"REF_ID for OID {oid} could not be converted to DOUBLE; setting NULL."
                            )
                            ref_id_val = None

                # Insert reference from source field
                r_cur.insertRow([
                    ref_id_val,      # REF_ID
                    "N",             # REF_PRIM
                    "point",         # SF_TYPE
                    int(oid)         # SF_UNIQUEID
                ])

                # Second reference: default REF_ID = 301162
                r_cur.insertRow([
                    301162.0,        # REF_ID default
                    "N",             # REF_PRIM
                    "point",         # SF_TYPE
                    int(oid)
                ])
        parameters[10].value = out_fc
        arcpy.AddMessage("sf_point, tbl_sf_visits, and tbl_sf_references created successfully. "
                         "EST_ID taken from the selected input field and stored as DOUBLE; non-numeric values set to NULL.")
    
    def postExecute(self, parameters):
        return
